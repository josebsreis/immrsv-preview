# Sanity — create a project at https://www.sanity.io/manage and paste its id.
# Leave PUBLIC_SANITY_PROJECT_ID empty to build the site from src/content/defaults.ts.
PUBLIC_SANITY_PROJECT_ID=
PUBLIC_SANITY_DATASET=production

# Only needed for previewing drafts / writing from the server. Never expose to the client.
SANITY_API_READ_TOKEN=

PUBLIC_SITE_URL=https://immrsv.studio
