---
import '@styles/global.css';
import Cursor from '@components/ui/Cursor.astro';
import { ClientRouter } from 'astro:transitions';
import Nav from '@components/layout/Nav.astro';
import Footer from '@components/layout/Footer.astro';
import { site } from '@lib/site';

interface Props {
  title?: string;
  description?: string;
  /** the page's starting theme; sections can override with their own data-theme */
  theme?: 'dark' | 'light';
  /** hide the shared nav (a page that renders its own) */
  noNav?: boolean;
  noFooter?: boolean;
}
const { title, description = 'IMMRSV — an independent practice working across architecture, creative media and digital products.', theme = 'dark', noNav = false, noFooter = false } = Astro.props;
const fullTitle = title ? `${title} — ${site.name}` : `${site.name} — Designing the future of experience`;
---
<!doctype html>
<html lang="en" data-theme={theme}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content={theme === 'dark' ? '#060606' : '#ffffff'} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <!-- the one file the page is set in: fetched alongside the CSS rather
         than after it, so the swap happens before the first paint is read -->
    <link rel="preload" href="/fonts/InterVariable.woff2" as="font" type="font/woff2" crossorigin />
    <!-- TRIAL: General Sans for the whole site, from Fontshare's free service;
         self-host the files if it is kept -->
    <link rel="preconnect" href="https://api.fontshare.com" />
    <link rel="preconnect" href="https://cdn.fontshare.com" crossorigin />
    <link rel="stylesheet" href="https://api.fontshare.com/v2/css?f[]=general-sans@400,500,600,700&display=swap" />
    <!-- TRIAL: JetBrains Mono for the short text in capitals -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;500&display=swap" />
    <!-- pages swap in place: the nav stays put and the rest cross-fades -->
    <ClientRouter />
    <slot name="head" />
  </head>
  <body data-theme={theme}>
    {/* the nav persists itself — see Nav.astro */}
    {!noNav && <Nav items={site.nav} />}
    <slot />
    {!noFooter && <Footer />}
    <Cursor />
  </body>
</html>
