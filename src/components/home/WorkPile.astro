---
/** The selected work, as a pile of cards fanned out on a dark table.
 *
 *  After Osmo's "Made with Osmo" (osmo.supply): the name of the section
 *  over the middle of the page, set as the studios' is, and under it one
 *  project square in the middle with the others tipped away to either side. The card on show is
 *  set in a frame — a white plate a little larger than the picture, with the
 *  project's name on its foot and the studio it came out of on the right —
 *  and the whole card, picture and frame, is the link into it. Throwing the pile hands the
 *  frame over: it draws back under the card that leaves and opens out from
 *  under the one that arrives.
 *
 *  The ground is dark so the page alternates again — light stories, dark
 *  work, light questions — and white renders on it read as lit.
 *
 *  The first pose is laid out here, from the same table the script uses, so
 *  the fan is already there before any script runs and without one. */
import type { HomeContent, Project } from '@lib/sanity/types';
import Button from '@components/ui/Button.astro';
import { site } from '@lib/site';
import { offset, poseFor, statusFor, transformOf } from '../../scripts/ui/workPile';

interface Props { content: HomeContent['work']; projects: Project[]; }
const { content, projects } = Astro.props;

const bySlug = new Map(projects.map((p) => [p.slug, p]));
const cards = content.featured
  .map((slug) => bySlug.get(slug))
  .filter((p): p is Project => Boolean(p?.cover));
const n = cards.length;
const studioName = (p: Project) => site.studios.find((s) => s.key === p.studios[0])?.label ?? '';
/** the card is about half the page wide, and the whole screen on a phone */
const SIZES = '(max-width: 859px) 82vw, 42vw';

const note = content.tag.split('\n');

/* The dial behind the pile, after Osmo's: two rings of small ticks
   pointing at the card in the middle, as one path — wide enough that both
   run off the section's edges rather than sitting inside it as a drawing,
   dense enough to read as a scale rather than as a scatter of marks. Each
   ring is ticked at the same spacing along its arc, and the outer one is
   set half a step round so the ticks do not line up into spokes. Units are
   the viewBox's; the stroke is a hairline whatever the size it is drawn at. */
const RINGS = [445, 540];
const SPACING = 20, TICK = 12;
/* one path a ring: each turns on its own — slowly, the two against each
   other, faster under the hand (scripts/ui/workPile.ts) */
const rings = RINGS.map((r, k) => {
  const count = Math.round((2 * Math.PI * r) / SPACING);
  const phase = k % 2 ? Math.PI / count : 0;
  let d = '';
  for (let t = 0; t < count; t++) {
    const a = phase + (t / count) * Math.PI * 2;
    const c = Math.cos(a), s = Math.sin(a);
    d += `M${(c * r).toFixed(1)} ${(s * r).toFixed(1)}L${(c * (r + TICK)).toFixed(1)} ${(s * (r + TICK)).toFixed(1)}`;
  }
  return d;
});
---
{n > 0 && (
  <section class="pile" id="selected-work" data-pile data-theme="dark" aria-labelledby="pile-title">
    <!-- a two-line note at the head of the section, in small capitals: the
         furniture of the page, set well above the name rather than on it -->
    <p class="note label">{note.map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
    <!-- the name over the middle of the page, as the studios' is -->
    <h2 class="title" id="pile-title" data-rise>{content.title}</h2>
    <p class="intro" data-rise style="--i: 1">{content.intro}</p>

    <!-- the table: the dial underneath, and the pile on it -->
    <div class="table">
    <svg class="dial" viewBox="-1000 -1000 2000 2000" aria-hidden="true" focusable="false">
      {rings.map((d, k) => <path class="ring" data-pile-ring={k} d={d} />)}
    </svg>
    <ul class="list" data-pile-list aria-roledescription="carousel" data-cursor-hover data-cursor-text="Drag" data-cursor-kind="drag">
      {cards.map((p, i) => {
        const d = offset(i, 0, n);
        const pose = poseFor(d);
        return (
          <li class="card" data-pile-card data-pile-status={statusFor(d)}
              style={`transform: ${transformOf(pose)}; opacity: ${pose.o}; z-index: ${pose.z}`}
              aria-hidden={d !== 0 ? 'true' : undefined}>
            <!-- The card is the way in: the picture and its frame are one
                 link, so there is nothing on it to aim for but the card. -->
            <a class="link" href={`/work/${p.slug}`} draggable="false" data-tap
               tabindex={d === 0 ? '0' : '-1'}>
              <!-- the frame: a white plate under the picture, clipped down to
                   the picture's own edge until this card is the one on show. It
                   carries the light ground's tokens without telling the nav. -->
              <div class="plate" data-panel="light">
                <div class="bar">
                  <h3 class="name">{p.title}</h3>
                  <span class="chip from">{studioName(p)}</span>
                </div>
              </div>

              <div class="media">
                <picture>
                  {p.cover!.avifSrcset && <source srcset={p.cover!.avifSrcset} sizes={SIZES} type="image/avif" />}
                  <img src={p.cover!.url} srcset={p.cover!.webpSrcset} sizes={SIZES}
                       alt={p.cover!.alt ?? p.title} width={p.cover!.width} height={p.cover!.height}
                       loading="lazy" decoding="async" draggable="false" />
                </picture>
              </div>
            </a>
          </li>
        );
      })}
    </ul>
    </div>

    <div class="more" data-rise>
      <Button href={content.cta.href} label={content.cta.label} />
    </div>
  </section>
)}

<style>
  /* The page's margins are the light section's; the ground has to reach the
     edges, so the section steps out of them and puts them back inside. It
     clips on both axes: the dial behind the pile is far bigger than the
     section and must not run on into the sections either side, and the
     tipped cards are well inside its padding. */
  .pile { position: relative; margin-inline: calc(var(--page-x) * -1);
          /* the page's rhythm, plus the room the note at the head takes */
          padding: calc(var(--section-y) + 6vh) var(--page-x) calc(var(--page-y) + 3rem + 14vh); overflow: clip;
          background: var(--ground); color: var(--ink);
          /* the card, its frame and the foot of the frame */
          --card-w: min(42vw, 48rem); --frame: var(--s-2); --foot: 4rem; }

  /* the note at the head and the button at the foot sit on the section's
     edges — the page margin in from each — with the pile between them */
  .note { position: absolute; left: 0; right: 0; top: var(--page-y); margin: 0;
          text-align: center; line-height: 1.7; color: var(--ink-3); }

  /* the studios' heading, to the letter: one name per section, one size */
  .title { text-align: center; font-size: var(--t-h2); font-weight: var(--w-display);
           line-height: var(--lh-display); letter-spacing: var(--track-display);
           color: var(--ink); white-space: nowrap; }
  /* the studios' line under their heading, to the letter */
  .intro { max-width: 42ch; margin: var(--s-4) auto 0; text-align: center; text-wrap: balance;
           font-size: var(--t-lead); line-height: var(--lh-lead);
           letter-spacing: var(--track-lead); color: var(--ink-3); }

  /* Every card in one cell of a grid, so they lie on top of one another and
     the list is as tall as one card. The room under it is the frame's foot
     and the chip, which hang below the card rather than inside it. */
  .table { position: relative; margin-top: var(--s-8); }

  /* The dial, centred on the card in the middle — half a card's height down
     the table, the cards being 16:10 — and larger than the screen either
     way, so its rings leave the section rather than end inside it. It fades
     out towards its edge, where it would otherwise stop on the section's
     border as a hard line. Each ring turns on its own, written by the
     script every frame while the section is on screen: slowly at rest, the
     two against each other; with the hand while the pile is dragged; and
     with a kick when a card is thrown. */
  .dial { position: absolute; left: 50%; top: calc(var(--card-w) * 0.3125);
          /* the page caps pictures at their column; this one is meant to
             run off the screen, so it is let out of that */
          width: 200vmax; height: 200vmax; max-width: none; translate: -50% -50%;
          pointer-events: none;
          fill: none; stroke: var(--ink-dim); stroke-width: 1;
          -webkit-mask-image: radial-gradient(closest-side, #000 62%, transparent 100%);
          mask-image: radial-gradient(closest-side, #000 62%, transparent 100%); }
  /* each ring turns about the middle of the drawing, which is its own centre */
  .ring { vector-effect: non-scaling-stroke; transform-box: fill-box; transform-origin: center;
          will-change: transform; }

  .list { position: relative; list-style: none; display: grid; justify-items: center;
          padding-bottom: calc(var(--foot) + var(--s-4));
          touch-action: pan-y; user-select: none; -webkit-user-select: none; }
  .pile[data-live] .list { cursor: grab; }
  .pile[data-drag] .list { cursor: grabbing; }

  .card { grid-area: 1 / 1; position: relative; width: var(--card-w);
          isolation: isolate; will-change: transform, opacity; }
  /* out past the second card on either side it has faded to nothing, and a
     card you cannot see must not be the one a click lands on */
  .card[data-pile-status="gone"] { pointer-events: none; }

  .media { display: block; aspect-ratio: 16 / 10; overflow: hidden;
           border-radius: var(--radius-media); background: var(--surface); }
  .link { display: block; color: inherit; }
  .media img { width: 100%; height: 100%; object-fit: cover; pointer-events: none;
               -webkit-user-drag: none; opacity: 0.5;
               transition: opacity var(--dur-fast) ease, scale var(--dur-base) var(--ease-panel); }
  .card[data-pile-status="near"] .media img { opacity: 0.75; }
  .card[data-pile-status="active"] .media img { opacity: 1; }

  /* The frame. The plate is larger than the picture by the frame on three
     sides and by the foot on the fourth, and sits under it; a clip holds it
     to the picture's own edge, where it cannot be seen, until the card is
     the one on show — and then it opens out from under it. The clip takes
     the clicks with it, so a closed plate's button cannot be pressed. */
  .plate { position: absolute; z-index: -1;
           inset: calc(var(--frame) * -1) calc(var(--frame) * -1) calc(var(--foot) * -1);
           background: var(--surface); border-radius: var(--radius-media);
           /* closed a pixel inside the picture's edge, not on it: exactly on
              it, the plate's white shows through the antialiasing at the
              rounded corners as a hairline round every card at the side */
           clip-path: inset(calc(var(--frame) + 1px) calc(var(--frame) + 1px) calc(var(--foot) + 1px) calc(var(--frame) + 1px) round var(--radius-media));
           transition: clip-path var(--dur-base) var(--ease-panel); }
  .card[data-pile-status="active"] .plate { clip-path: inset(0 round var(--radius-media)); }

  .bar { position: absolute; left: 0; right: 0; bottom: 0; height: var(--foot);
         display: flex; align-items: center; justify-content: space-between;
         gap: var(--s-4); padding: 0 var(--s-4); }
  .from { flex: none; }
  .name { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
          font-size: var(--t-title); font-weight: var(--w-title);
          letter-spacing: var(--track-title); color: var(--ink); }
  /* the name and the studio fade in once the frame has opened, a beat behind it */
  .bar > * { opacity: 0; transition: opacity 0.4s var(--ease-snap); }
  .card[data-pile-status="active"] .bar > * { opacity: 1;
                                                            transition-delay: 0.08s; }

  /* With no button on it, the card has to say it can be pressed: the picture
     eases in a touch under the pointer, inside a frame that holds still. */
  @media (hover: hover) and (pointer: fine) {
    .card[data-pile-status="active"] .link:hover .media img { scale: 1.03; }
  }

  .more { position: absolute; left: 0; right: 0; bottom: var(--page-y);
          display: flex; justify-content: center; }

  @media (max-width: 859px) {
    .pile { padding: calc(var(--section-y) + 2vh) var(--page-x) calc(var(--page-y) + 3rem + 10vh); --card-w: 82vw; --foot: 3.5rem; }
    .title { white-space: normal; font-size: var(--t-h3); }
    .table { margin-top: var(--s-7); }
    .name { font-size: var(--t-lead); }
  }
  @media (prefers-reduced-motion: reduce) {
    .plate, .bar > *, .media img { transition: none; }
  }
</style>
