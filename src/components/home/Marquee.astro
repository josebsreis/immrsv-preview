---
/** The band between the hero and the statement: what the practice does, said
 *  once, moving. It is a separator first — the page needs a breath there, not
 *  another block — so it is a hairline band the full width of the screen
 *  rather than a panel with margins.
 *
 *  The moving copy is hidden from assistive tech and a single still copy is
 *  exposed instead: a marquee read aloud three times over is nobody's idea of
 *  an accessible page. */
interface Props { items: string[]; label?: string }
const { items, label = 'What we do' } = Astro.props;
/** twice through, so the second run is already in place when the first leaves */
const runs = [0, 1];
---
<section class="band" aria-label={label} data-marquee data-marquee-speed="46" data-marquee-drag="1.5">
  {['top', 'bottom'].map((side) => (
    <div class={`rail rail-${side}`} data-marquee-track data-marquee-dir="right" data-marquee-rate="0.55" aria-hidden="true">
      <div class="rail-run">{Array.from({ length: 16 }).map(() => <i class="pip"></i>)}</div>
    </div>
  ))}
  <div class="track" data-marquee-track aria-hidden="true">
    {runs.map(() => (
      <div class="run">
        {items.map((item) => (
          <span class="item"><span class="dot"></span>{item}</span>
        ))}
      </div>
    ))}
  </div>
  <p class="sr">{items.join(', ')}.</p>
</section>

<style>
  /* the band is its own beat: the same air above it as below, and the section
     under it gives up its top padding so the two gaps stay equal */
  .band { position: relative; z-index: var(--z-ui);
          margin: 10vh 0; padding-block: clamp(2.5rem, 7vh, 5.5rem);
          border-top: var(--hairline) solid var(--line);
          border-bottom: var(--hairline) solid var(--line);
          overflow: hidden; }
  /* the run is driven from a script — one transform a frame — so that the
     scroll can lend it speed and turn it round; with no script it still runs,
     on the keyframes below */
  .track { display: flex; width: max-content; animation: run 42s linear infinite; will-change: transform; }
  [data-marquee-status] .track { animation: none; }
  .run { display: flex; flex: none; }

  /* the square sits between two words, so the space either side of it has to
     match: the gap after it and the padding before the next one are one value */
  .item { display: flex; align-items: center; gap: 1.5em;
          padding-right: 1.5em;
          font-size: clamp(1.5rem, 4vw, 3rem);
          font-weight: 500; letter-spacing: -0.02em; line-height: 1;
          white-space: nowrap; color: var(--ink-2); }
  /* the squares of the lattice, at the scale of a word. They stand on their
     corner when the band turns round — a square rotated by anything but 45°
     is a square, so this is the one angle that shows */
  .dot { flex: none; width: 0.26em; height: 0.26em; background: var(--ink-4);
         transition: transform 0.5s cubic-bezier(0.625, 0.05, 0, 1), background-color 0.5s ease; }
  [data-marquee-status="inverted"] .dot { transform: rotate(45deg); background: var(--ink-2); }

  /* the squares ride the hairlines, running against the words: counter-motion
     is what gives a flat band a near side and a far one */
  .rail { position: absolute; left: 0; display: flex; width: max-content; pointer-events: none; }
  .rail-top { top: 0; }
  .rail-bottom { bottom: 0; }
  .rail-run { display: flex; flex: none; }
  /* they sit against the line rather than centred on it: the band clips its
     own overflow, so a square straddling the border would lose half of itself */
  .pip { flex: none; width: 5px; height: 5px; background: var(--ink-3); margin-right: 4.5rem; }

  @keyframes run { to { transform: translateX(-50%); } }

  /* nothing moves for a reader who asked for less; the band still separates */
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
  }

  @media (max-width: 719px) { .band { margin: 8vh 0; } }

  .sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
        overflow: hidden; clip-path: inset(50%); white-space: nowrap; }
</style>
