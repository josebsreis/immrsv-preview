---
/** The band between the hero and the statement: what the practice does, said
 *  once, moving. It is a separator first — the page needs a breath there, not
 *  another block — so it is a hairline band the full width of the screen
 *  rather than a panel with margins.
 *
 *  The moving copy is hidden from assistive tech and a single still copy is
 *  exposed instead: a marquee read aloud three times over is nobody's idea of
 *  an accessible page. */
interface Props { items: string[]; label?: string }
const { items, label = 'What we do' } = Astro.props;
/** twice through, so the second run is already in place when the first leaves */
const runs = [0, 1];
---
<section class="band" aria-label={label} data-marquee data-marquee-speed="46" data-marquee-drag="1.5">
  <div class="track" data-marquee-track aria-hidden="true">
    {runs.map(() => (
      <div class="run">
        {items.map((item) => (
          <span class="item">
            <span class="pips" aria-hidden="true">
              <i class="sq"></i><i class="sq"></i><i class="sq"></i>
              <i class="sq"></i><i class="sq"></i><i class="sq"></i>
            </span>
            {item}
          </span>
        ))}
      </div>
    ))}
  </div>
  <p class="visually-hidden">{items.join(', ')}.</p>
</section>

<style>
  /* The band is its own beat: the same air above it as below. Equal margins
     were not enough — the hero's last row floats --page-y clear of the hero's
     own bottom edge, so that inset lands on top of the gap above and nothing
     answers it below. The top margin gives it back. */
  .band { position: relative; z-index: var(--z-ui);
          margin: calc(10vh - var(--page-y)) 0 10vh; padding-block: clamp(2.5rem, 7vh, 5.5rem);
          border-top: var(--hairline) solid var(--line);
          border-bottom: var(--hairline) solid var(--line);
          overflow: hidden; }
  /* the run is driven from a script — one transform a frame — so that the
     scroll can lend it speed and turn it round; with no script it still runs,
     on the keyframes below */
  .track { display: flex; width: max-content; animation: run 42s linear infinite; will-change: transform; }
  [data-marquee-status] .track { animation: none; }
  .run { display: flex; flex: none; }

  /* the square sits between two words, so the space either side of it has to
     match: the gap after it and the padding before the next one are one value */
  .item { display: flex; align-items: center; gap: 1.5em;
          padding-right: 1.5em;
          font-size: clamp(1.5rem, 4vw, 3rem);
          font-weight: var(--w-title); letter-spacing: var(--track-display); line-height: 1;
          white-space: nowrap; color: var(--ink-2); }
  /* Six of the site's square rather than one blown up to the size of a word:
     the marker is --square everywhere it appears, and a word-high one here was
     the only place it was not. Laid out on a grid they make a double chevron
     — « — which points the way the band is running, so the mark says what it
     is for instead of merely sitting between two words.

         · X · X        columns 2 and 4 hold the two backs,
         X · X ·        columns 1 and 3 the two points
         · X · X

     Reading down runs the band left and it points left; reading back up turns
     the band round and the whole cluster mirrors. That is the entire state:
     one scaleX, which is what a chevron changing sides actually is.

     A pulse runs back-to-point, and needs no second version for the mirrored
     state — the flip carries the squares' identities with their positions, so
     the same order still reads tail first. */
  .pips { flex: none; display: grid;
          grid-template-columns: repeat(4, var(--square));
          grid-template-rows: repeat(3, var(--square));
          gap: 0.1875rem;
          color: var(--ink-4);
          transform: scaleX(1); transform-origin: center;
          transition: transform 0.5s cubic-bezier(0.625, 0.05, 0, 1),
                      color 0.5s ease; }
  /* the near chevron */
  .pips .sq:nth-child(1) { grid-area: 1 / 2; }
  .pips .sq:nth-child(2) { grid-area: 2 / 1; }
  .pips .sq:nth-child(3) { grid-area: 3 / 2; }
  /* and the one behind it */
  .pips .sq:nth-child(4) { grid-area: 1 / 4; }
  .pips .sq:nth-child(5) { grid-area: 2 / 3; }
  .pips .sq:nth-child(6) { grid-area: 3 / 4; }

  .pips .sq { animation: glimmer 2.2s ease-in-out infinite; }
  /* the back one lights first, then the point */
  .pips .sq:nth-child(n + 4) { animation-delay: 0s; }
  .pips .sq:nth-child(-n + 3) { animation-delay: 0.22s; }

  /* turned round: the chevron mirrors and comes up a shade */
  [data-marquee-status="inverted"] .pips { transform: scaleX(-1); color: var(--ink-2); }

  @keyframes glimmer {
    0%, 45%, 100% { opacity: 0.42; }
    18% { opacity: 1; }
  }

  @keyframes run { to { transform: translateX(-50%); } }

  /* nothing moves for a reader who asked for less; the band still separates */
  @media (prefers-reduced-motion: reduce) {
    .track { animation: none; }
    .pips .sq { animation: none; opacity: 0.7; }
  }

  @media (max-width: 719px) { .band { margin: calc(8vh - var(--page-y)) 0 8vh; } }

</style>
