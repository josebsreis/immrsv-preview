---
/** About: the practice stated in one sentence read a word at a time, then the
 *  supporting columns, the facts row and the numbered positions — the ground
 *  the services section stands on. Every block below the statement is optional
 *  and renders only when the content carries it. */
import Button from '@components/ui/Button.astro';
import type { HomeContent } from '@lib/sanity/types';
interface Props { content: HomeContent['about']; }
const { content } = Astro.props;
const facts = content.facts ?? [];
const principles = content.principles ?? [];
---
<section class="about" id="about">
  <span class="tag label">{content.tag}</span>
  <h2 data-reveal-words>{content.statement}</h2>
  <div class="rule" data-rule><i></i></div>
  <div class="cols">
    <p class="caps" set:html={content.caps.replace(/\n/g, '<br>')} />
    <div class="col-r">
      <p>{content.body}</p>
      <Button href={content.cta.href} label={content.cta.label} class="more" />
    </div>
  </div>

  {facts.length > 0 && (
    <ul class="facts">
      {facts.map((f, i) => (
        <li data-rise style={`--i: ${i}`}>
          <span class="f-value">{f.value}</span>
          <span class="f-label label">{f.label}</span>
        </li>
      ))}
    </ul>
  )}

  {principles.length > 0 && (
    <ol class="principles">
      {principles.map((p, i) => (
        <li data-rise style={`--i: ${i}`}>
          <span class="p-n label">{String(i + 1).padStart(2, '0')}</span>
          <h3>{p.title}</h3>
          <p>{p.text}</p>
        </li>
      ))}
    </ol>
  )}
</section>

<style>
  /* above the hero's fixed layers (fluid, mark, veil), under the shutter */
  .about { position: relative; z-index: var(--z-ui); padding: 22vh var(--page-x) 26vh; display: grid; grid-template-columns: 8.125rem 1fr; column-gap: var(--s-6); align-items: start; }
  .tag { grid-column: 1; letter-spacing: 0.2em; color: var(--ink-3); padding-top: 0.9em; }
  h2 { grid-column: 2; font-size: var(--t-h2); line-height: 1.04; letter-spacing: -0.025em; font-weight: 400; color: var(--ink); }
  /* every word starts dim and lifts as the line is read */
  h2 :global(.w) { display: inline-block; color: var(--ink-dim); transition: color var(--dur-base) ease; }
  h2 :global(.w.lit) { color: inherit; }

  /* the rule draws across; the line is cut around the cross, nothing opaque on the live background */
  .rule { grid-column: 1 / -1; position: relative; height: var(--hairline); margin: 12vh 0 9vh; --x: 67%; }
  .rule::before, .rule i { position: absolute; inset: 0 auto 0 0; width: 100%;
    mask: linear-gradient(90deg, #000 calc(var(--x) - 0.8125rem), transparent calc(var(--x) - 0.8125rem), transparent calc(var(--x) + 0.8125rem), #000 calc(var(--x) + 0.8125rem)); }
  .rule::before { content: ""; background: var(--line); }
  .rule i { background: var(--line-strong); clip-path: inset(0 100% 0 0); transition: clip-path 1.4s cubic-bezier(0.16, 0.8, 0.24, 1); }
  .rule:global(.in) i { clip-path: inset(0 0 0 0); }
  .rule::after { content: "×"; position: absolute; left: var(--x); top: 50%; transform: translate(-50%, -50%); font-size: var(--t-caption); color: var(--ink-4); }

  .cols { grid-column: 2; display: grid; grid-template-columns: 1fr 1fr; column-gap: var(--s-6); }
  .caps { font-size: var(--t-caption); line-height: 1.85; letter-spacing: 0.14em; text-transform: uppercase; color: var(--ink-2); }
  .col-r p { font-size: var(--t-body); line-height: 1.65; color: var(--ink-3); max-width: 44ch; }
  .col-r :global(.more) { margin-top: var(--s-7); }

  /* the facts: a figure and what it counts, on their own hairline row */
  .facts { grid-column: 2; list-style: none; display: grid; grid-template-columns: repeat(4, 1fr);
           gap: var(--s-5); margin-top: 16vh; padding-top: var(--s-5); border-top: var(--hairline) solid var(--line); }
  .facts li { display: flex; flex-direction: column; gap: 0.625rem; }
  .f-value { font-size: clamp(1.75rem, 2.6vw, 2.5rem); line-height: 1; letter-spacing: -0.03em; color: var(--ink); }
  .f-label { color: var(--ink-4); }

  /* the positions, numbered, each under its own hairline */
  .principles { grid-column: 2; list-style: none; display: grid; grid-template-columns: repeat(3, 1fr); gap: var(--s-6); margin-top: 16vh; }
  .principles li { padding-top: var(--s-4); border-top: var(--hairline) solid var(--line); }
  .p-n { display: block; color: var(--ink-4); margin-bottom: var(--s-5); }
  .principles h3 { font-size: var(--t-lead); font-weight: 400; letter-spacing: -0.015em; color: var(--ink); margin-bottom: var(--s-3); }
  .principles p { font-size: var(--t-small); line-height: 1.6; color: var(--ink-3); }

  @media (max-width: 1099px) {
    .facts { grid-template-columns: repeat(2, 1fr); row-gap: var(--s-6); }
  }
  @media (max-width: 859px) {
    .about { grid-template-columns: 1fr; row-gap: var(--s-4); padding: 16vh 1.25rem 20vh; }
    .tag, h2, .cols, .facts, .principles { grid-column: 1; }
    .cols { grid-template-columns: 1fr; row-gap: var(--s-6); }
    .rule { --x: 50%; }
    .facts, .principles { margin-top: 12vh; }
    .principles { grid-template-columns: 1fr; gap: var(--s-5); }
  }
  @media (max-width: 719px) {
    .facts { gap: var(--s-5); }
  }
</style>
