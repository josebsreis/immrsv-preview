---
/** The clients, as their own marks: a rule across the top, the name of the
 *  row at the left, and at the right — on the page's split, where every
 *  right-hand column starts — six marks, three across, standing free: no
 *  frames, nothing under the pointer. The row shows six at a time and swaps
 *  one for another every so often, the mark going out of focus and the next
 *  coming in, the way the hero's word and the footer's turn over
 *  (scripts/ui/brandSwap.ts). The files are black artwork, so the theme
 *  supplies the filter that flips them. */
import type { HomeContent } from '@lib/sanity/types';
interface Props { content: HomeContent['brands']; }
const { content } = Astro.props;
/** how many stand in the row at once */
const SHOWN = 6;
const pool = content.items.map((b) => ({ name: b.name, url: b.logo.url, alt: b.logo.alt ?? b.name }));
/* six cells whatever the pool holds: with fewer marks than cells some
   stand twice until the client sends the rest */
const first = Array.from({ length: SHOWN }, (_, i) => pool[i % pool.length]);
---
{pool.length > 0 && (
  <section class="brands" aria-label={content.tag} data-brands>
    <p class="lead label">{content.tag}</p>
    <ul class="grid">
      {first.map((b, i) => (
        <li data-brand-cell data-brand={pool.indexOf(b)}>
          <img src={b.url} alt={b.alt} loading={i < SHOWN ? 'eager' : 'lazy'} />
        </li>
      ))}
    </ul>
    <!-- Every mark the row can swap in, as plain image tags in a template:
         never drawn, but real `src` attributes in the page, so the preview's
         path rewrite (scripts/rebase.mjs) reaches them. A list kept as JSON
         in an attribute has its quotes escaped and was skipped, so every
         swapped-in mark pointed at the site root and failed to load. -->
    <template data-brand-pool>
      {pool.map((b) => <img src={b.url} alt={b.alt} />)}
    </template>
  </section>
)}

<style>
  /* the page's split: the name in the left column, the marks starting
     where every right-hand column on the page starts; a rule across the
     top of both, and a section's air under */
  .brands { position: relative; display: grid;
            grid-template-columns: minmax(0, var(--col-side)) minmax(0, 1fr);
            column-gap: var(--col-gap); align-items: start;
            /* the same air under the rule as the marquee keeps under its own */
            padding: clamp(2.5rem, 7vh, 5.5rem) 0 var(--section-y);
            border-top: var(--hairline) solid var(--line); }

  /* the label, plain: the same word and size as the studios' "What we do" */
  .lead { margin: 0; color: var(--ink-3); }

  /* six marks, three across, standing free: each centred in its own share
     of the row, with the row's air between them */
  .grid { list-style: none; margin: 0; padding: 0; display: grid;
          grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 0 var(--s-6); }
  .grid li { display: grid; place-items: center; height: 9rem; padding: var(--s-5) var(--s-4); }
  /* a hairline under every mark but those in the last row: three across,
     so the last three go without */
  .grid li:not(:nth-last-child(-n + 3)) { border-bottom: var(--hairline) solid var(--line); }

  img { position: relative; max-height: 3.25rem; max-width: 100%; width: auto; object-fit: contain;
        filter: var(--logo-filter); opacity: 0.82;
        /* the swap: out of focus and gone, then the next one in — the
           hero's own turn, at its own pace */
        transition: opacity 0.75s ease-in-out, filter 0.75s ease-in-out; }
  img.out { opacity: 0; filter: var(--logo-filter) blur(9px); }

  @media (max-width: 859px) {
    .brands { grid-template-columns: minmax(0, 1fr); row-gap: var(--s-5); }
  }
  @media (max-width: 719px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--s-5); }
    /* two across here, so only the last two go without */
    .grid li:not(:nth-last-child(-n + 3)) { border-bottom: 0; }
    .grid li:not(:nth-last-child(-n + 2)) { border-bottom: var(--hairline) solid var(--line); }
    .grid li { height: 7.5rem; }
    img { max-height: 2.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { img { transition: none; } }
</style>
