---
/** The clients, as their own marks. The files are black artwork, so the theme
 *  supplies the filter that flips them — nothing is re-exported per theme. */
import type { HomeContent } from '@lib/sanity/types';
interface Props { content: HomeContent['brands']; }
const { content } = Astro.props;
---
{content.items.length > 0 && (
  <section class="brands" aria-label={content.tag}>
    <p class="tag"><span class="sq" aria-hidden="true"></span>{content.tag}</p>
    <ul class="grid">
      {content.items.map((b, i) => (
        <li data-rise style={`--i: ${i}`}>
          <img src={b.logo.url} alt={b.logo.alt ?? b.name} loading="lazy" />
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  /* above the hero's fixed layers, under the shutter */
  .brands { position: relative; z-index: var(--z-ui); padding: 8vh var(--page-x) 12vh;
            display: grid; grid-template-columns: minmax(0, var(--col-side)) minmax(0, 1fr);
            column-gap: var(--col-gap); align-items: start;
            border-top: var(--hairline) solid var(--line); }
  .tag { display: flex; align-items: center; gap: 0.75rem; font-size: var(--t-body); color: var(--ink); }
  .tag :global(.sq) { color: var(--ink-4); }

  .grid { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); }
  /* the hairlines make the grid; only the inner edges are drawn */
  /* logos sit on the left of their cell, so the first column's ink lands on
     the same line as the statement above it */
  .grid li { display: grid; place-items: center start; height: 8.5rem; padding: var(--s-5);
             border-bottom: var(--hairline) solid var(--line); border-right: var(--hairline) solid var(--line); }
  .grid li:nth-child(4n + 1) { padding-left: 0; }
  .grid li:nth-child(4n) { border-right: 0; }
  .grid li:nth-last-child(-n + 4) { border-bottom: 0; }
  .grid img { max-height: 3.25rem; max-width: 100%; width: auto; object-fit: contain; filter: var(--logo-filter); opacity: 0.92; }

  @media (max-width: 1099px) { .brands { grid-template-columns: 1fr; row-gap: var(--s-7); } }
  @media (max-width: 719px) {
    .brands { padding: 6vh 1.25rem 10vh; }
    .grid { grid-template-columns: repeat(2, 1fr); }
    /* two columns changes which cells are on an edge — restore, then re-cut */
    .grid li { height: 6.5rem; padding: var(--s-4); border-bottom: var(--hairline) solid var(--line); border-right: var(--hairline) solid var(--line); }
    .grid li:nth-child(4n + 1) { padding-left: var(--s-4); }
    .grid li:nth-child(2n + 1) { padding-left: 0; }
    .grid li:nth-child(2n) { border-right: 0; }
    .grid li:nth-last-child(-n + 2) { border-bottom: 0; }
    .grid img { max-height: 2.5rem; }
  }
</style>
