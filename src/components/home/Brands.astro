---
/** The clients, as their own marks — each in an outlined cell with the site's
 *  square at every corner. Hovering slides a panel in from whichever edge the
 *  cursor crossed (scripts/ui/directionalHover.ts). The files are black
 *  artwork, so the theme supplies the filter that flips them. */
import type { HomeContent } from '@lib/sanity/types';
interface Props { content: HomeContent['brands']; }
const { content } = Astro.props;
---
{content.items.length > 0 && (
  <section class="brands" aria-label={content.tag}>
    <p class="tag"><span class="sq" aria-hidden="true"></span>{content.tag}</p>
    <ul class="grid" data-dhover>
      {content.items.map((b, i) => (
        <li data-dhover-item data-rise style={`--i: ${i}`}>
          <span class="tile" data-dhover-tile aria-hidden="true"></span>
          <i class="c tl"></i><i class="c tr"></i><i class="c bl"></i><i class="c br"></i>
          <img src={b.logo.url} alt={b.logo.alt ?? b.name} loading="lazy" />
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  /* above the hero's fixed layers, under the shutter */
  .brands { position: relative; z-index: var(--z-ui); padding: 8vh var(--page-x) 12vh;
            display: grid; grid-template-columns: minmax(0, var(--col-side)) minmax(0, 1fr);
            column-gap: var(--col-gap); align-items: start;
            border-top: var(--hairline) solid var(--line); }
  .tag { display: flex; align-items: center; gap: 0.75rem; font-size: var(--t-body); color: var(--ink); }
  .tag :global(.sq) { color: var(--ink-4); }

  .grid { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-3); }
  .grid li { position: relative; overflow: hidden; display: grid; place-items: center;
             height: 8.5rem; padding: var(--s-5);
             border: var(--hairline) solid var(--line); }

  /* the panel that arrives from the edge the cursor crossed */
  .tile { position: absolute; inset: 0; background: var(--glass-hover);
          transform: translateY(-100%); will-change: transform;
          transition: transform 0.5s cubic-bezier(0.16, 1, 0.3, 1); }

  /* the site's square, one at each corner */
  .c { position: absolute; width: var(--square); height: var(--square); background: var(--marker);
       pointer-events: none; transition: background var(--dur-fast) ease; }
  .tl { left: 0; top: 0; } .tr { right: 0; top: 0; } .bl { left: 0; bottom: 0; } .br { right: 0; bottom: 0; }
  .grid li:hover .c { background: var(--marker-hover); }

  img { position: relative; max-height: 3.25rem; max-width: 100%; width: auto; object-fit: contain;
        filter: var(--logo-filter); opacity: 0.82; transition: opacity var(--dur-fast) ease; }
  .grid li:hover img { opacity: 1; }

  @media (max-width: 1099px) { .brands { grid-template-columns: 1fr; row-gap: var(--s-7); } }
  @media (max-width: 719px) {
    .brands { padding: 6vh 1.25rem 10vh; }
    .grid { grid-template-columns: repeat(2, 1fr); gap: var(--s-2); }
    .grid li { height: 6.5rem; padding: var(--s-4); }
    img { max-height: 2.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .tile { transition: none; } }
</style>
