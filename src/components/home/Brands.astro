---
/** The clients, as their own marks. The files are black artwork, so the theme
 *  supplies the filter that flips them — nothing is re-exported per theme. */
import type { HomeContent } from '@lib/sanity/types';
interface Props { content: HomeContent['brands']; }
const { content } = Astro.props;
---
{content.items.length > 0 && (
  <section class="brands" aria-label={content.tag}>
    <p class="tag"><span class="sq" aria-hidden="true"></span>{content.tag}</p>
    <ul class="grid">
      {content.items.map((b, i) => (
        <li data-rise style={`--i: ${i}`}>
          <span class="logo"><img src={b.logo.url} alt={b.logo.alt ?? b.name} loading="lazy" /></span>
          <span class="name label">{b.name}</span>
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  /* above the hero's fixed layers, under the shutter */
  .brands { position: relative; z-index: var(--z-ui); padding: 8vh var(--page-x) 12vh;
            display: grid; grid-template-columns: 1fr 2fr; column-gap: var(--s-8); align-items: start;
            border-top: var(--hairline) solid var(--line); }
  .tag { display: flex; align-items: center; gap: 0.75rem; font-size: var(--t-body); color: var(--ink); }
  .tag :global(.sq) { color: var(--ink-4); }

  .grid { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr); gap: var(--s-6) var(--s-5); }
  .grid li { display: flex; flex-direction: column; align-items: center; gap: var(--s-5);
             padding-bottom: var(--s-5); border-bottom: var(--hairline) solid var(--line); }
  .logo { display: grid; place-items: center; width: 100%; height: 4.5rem; }
  .logo img { max-height: 100%; width: auto; object-fit: contain; filter: var(--logo-filter); opacity: 0.92; }
  .name { color: var(--ink-4); text-align: center; }

  @media (max-width: 1099px) { .brands { grid-template-columns: 1fr; row-gap: var(--s-7); } }
  @media (max-width: 719px) {
    .brands { padding: 6vh 1.25rem 10vh; }
    .grid { grid-template-columns: repeat(2, 1fr); }
    .logo { height: 3.25rem; }
  }
</style>
