---
/** The clients, as their own marks, set in one lattice: neighbouring cells
 *  share their line. No squares on the crossings — the marker is for naming
 *  things, and here it was decoration. Hovering
 *  slides a panel in from whichever edge the cursor crossed
 *  (scripts/ui/directionalHover.ts). The files are black artwork, so the
 *  theme supplies the filter that flips them. */
import type { HomeContent } from '@lib/sanity/types';
interface Props { content: HomeContent['brands']; }
const { content } = Astro.props;
---
{content.items.length > 0 && (
  <section class="brands" aria-label={content.tag}>
    <!-- the name of the section is a cell of the lattice itself: one column
         wide, standing on the first mark, sharing its line and its corners -->
    <p class="lead" data-rise>{content.tag}</p>
    <ul class="grid" data-dhover>
      {content.items.map((b, i) => (
        <li data-dhover-item data-rise style={`--i: ${i}`}>
          <span class="clip" aria-hidden="true"><span class="tile" data-dhover-tile></span></span>
          <img src={b.logo.url} alt={b.logo.alt ?? b.name} loading="lazy" />
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  /* it sits inside the light section, which already holds the page margins */
  .brands { position: relative; padding: 0 0 11vh; }

  /* The name's cell: the top and both sides are its own, the line under it
     is the grid's top, so the two are one drawing. A column wide, like the
     cells below it, and shorter — it holds a line of small type, not a mark. */
  /* exactly the first column: the grid's left line, then a quarter of what is
     left — a plain quarter left its right line a hair short of the cell's */
  .lead { width: calc(var(--hairline) + (100% - var(--hairline)) / 4); height: 3.25rem; padding: 0 var(--s-5); position: relative;
          border-top: var(--hairline) solid var(--line);
          border-left: var(--hairline) solid var(--line);
          border-right: var(--hairline) solid var(--line);
          margin: 0; display: flex; align-items: center;
          font-size: var(--t-small); color: var(--ink-2); }

  /* one lattice: the container draws the top and left, each cell the line to
     its right and below, so every inner line is shared by two cells */
  /* four to a row at every size but a phone, where it halves: eight in one
     row made each mark a stamp, and two rows of four is a block with some
     weight to it */
  .grid { list-style: none; display: grid; grid-template-columns: repeat(4, 1fr);
          border-top: var(--hairline) solid var(--line); border-left: var(--hairline) solid var(--line); }
  .grid li { position: relative; display: grid; place-items: center;
             height: 8.5rem; padding: var(--s-5);
             border-right: var(--hairline) solid var(--line);
             border-bottom: var(--hairline) solid var(--line); }

  /* the panel that arrives from the edge the cursor crossed, clipped to the cell */
  .clip { position: absolute; inset: 0; overflow: hidden; }
  .tile { position: absolute; inset: 0; background: var(--glass-hover);
          transform: translateY(-100%); will-change: transform;
          transition: transform var(--dur-base) var(--ease-panel); }

  img { position: relative; max-height: 3.25rem; max-width: 100%; width: auto; object-fit: contain;
        filter: var(--logo-filter); opacity: 0.82; transition: opacity var(--dur-fast) ease; }
  .grid li:hover img { opacity: 1; }

  @media (max-width: 719px) {
    .brands { padding: 0 0 10vh; }
    .lead { width: calc(var(--hairline) + (100% - var(--hairline)) / 2); }
    .grid { grid-template-columns: repeat(2, 1fr); }
    .grid li { height: 6.5rem; }
    img { max-height: 2.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .tile { transition: none; } }
</style>
