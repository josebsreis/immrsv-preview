---
/** The clients, as their own marks, each in a frame of its own with air
 *  between them, under a plain label at the left — the same small word the
 *  studios' "What we do" is set in. Hovering slides a panel in from
 *  whichever edge the cursor crossed (scripts/ui/directionalHover.ts). The
 *  files are black artwork, so the theme supplies the filter that flips
 *  them. */
import type { HomeContent } from '@lib/sanity/types';
interface Props { content: HomeContent['brands']; }
const { content } = Astro.props;
---
{content.items.length > 0 && (
  <section class="brands" aria-label={content.tag}>
    <p class="lead label">{content.tag}</p>
    <ul class="grid" data-dhover>
      {content.items.map((b) => (
        <li data-dhover-item>
          <span class="clip" aria-hidden="true"><span class="tile" data-dhover-tile></span></span>
          <img src={b.logo.url} alt={b.logo.alt ?? b.name} loading="lazy" />
        </li>
      ))}
    </ul>
  </section>
)}

<style>
  /* it sits inside the light section, which already holds the page margins */
  .brands { position: relative; padding: 0 0 var(--section-y); }

  /* the label, plain, at the left: the same word and size as the studios'
     "What we do", naming the row under it */
  .lead { margin: 0 0 var(--s-5); color: var(--ink-3); }

  /* each mark in a frame of its own, with air between the frames: four to
     a row at every size but a phone, where it halves */
  .grid { list-style: none; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr));
          gap: var(--s-4); margin: 0; padding: 0; }
  .grid li { position: relative; display: grid; place-items: center;
             height: 8.5rem; padding: var(--s-5); background: var(--ground);
             border: var(--hairline) solid var(--line); border-radius: var(--radius); overflow: hidden; }

  /* the panel that arrives from the edge the cursor crossed, clipped to the cell */
  .clip { position: absolute; inset: 0; overflow: hidden; }
  .tile { position: absolute; inset: 0; background: var(--glass-hover);
          transform: translateY(-100%); will-change: transform;
          transition: transform var(--dur-base) var(--ease-panel); }

  img { position: relative; max-height: 3.25rem; max-width: 100%; width: auto; object-fit: contain;
        filter: var(--logo-filter); opacity: 0.82; transition: opacity var(--dur-fast) ease; }
  @media (hover: hover) and (pointer: fine) { .grid li:hover img { opacity: 1; } }

  @media (max-width: 719px) {
    .grid { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-3); }
    .grid li { height: 6.5rem; }
    img { max-height: 2.5rem; }
  }
  @media (prefers-reduced-motion: reduce) { .tile { transition: none; } }
</style>
