---
/** The three studios, one full screen each.
 *
 *  A studio is a panel, not a card: its number and name at the top left, what
 *  it promises and what that means at the top right, its work at the bottom
 *  left and what it does at the bottom right — with the middle left empty.
 *  The void is the point. Pinning the content to the top and the foot of the
 *  screen is what makes three sections of the same shape read as three of one
 *  thing rather than as a list, and it is the one layout that a practice
 *  selling precision can hold without looking sparse.
 *
 *  The grounds alternate — light, dark, light — so each panel arrives as its
 *  own place. And they are stacked rather than laid end to end: all three are
 *  pinned to the top of the screen with the first one covering, and scrolling
 *  lifts it, whole, off the top to leave the one beneath. Nothing arrives;
 *  something is taken away (scripts/ui/studioStack.ts).
 *
 *  The work is links now. Each frame opens the project it shows, which is why
 *  nothing in the reel follows the pointer — see scripts/ui/studioReel.ts. */
import type { HomeContent } from '@lib/sanity/types';
import Button from '@components/ui/Button.astro';
import work from '../../content/work.generated.json';

interface Props { content: HomeContent['studios']; }
const { content } = Astro.props;

/* The studios' own work, as delivered by the client and squeezed down by
   scripts/images.mjs. */
const FOLDER: Record<string, string> = { architecture: 'architecture-design', media: 'creative-media', products: 'digital-products' };
/** every panel carries the same count, so the three reels read as three of
 *  one thing rather than as three different amounts of work */
const PER_STUDIO = 3;
type Shot = { src: string; name: string; slug: string; widths: number[] };
type Delivered = { studio: string; name: string; slug: string; images: { src: string; widths: number[] }[] };
const projects = work as Delivered[];
/** the still, extension-less; the ladder of widths that exists of it rides
 *  alongside, so the browser picks the one its screen wants */
const frame = (im: { src: string; widths: number[] }) => im.src;
const ladder = (s: Shot, ext: string) => s.widths.map((w) => `${s.src}-${w}.${ext} ${w}w`).join(', ');
/** the reel is a band under half the page wide, and the whole page on a phone */
const REEL_SIZES = '(max-width: 859px) 100vw, 42vw';
/** every render there is, in delivery order */
const everything: Shot[] = projects.flatMap((p) => p.images.map((im) => ({ src: frame(im), widths: im.widths, name: p.name, slug: p.slug })));

/**
 * A studio's three frames: its own projects first, one frame each. A studio
 * with fewer than three borrows — its own spare renders before anyone else's,
 * then work from across the practice, spread through the pool rather than
 * taken off the top so the borrowed frames are not all the same building.
 * Stand-ins until the client sends the rest; nothing here is invented.
 */
const reelFor = (key: string): Shot[] => {
  const mine = projects.filter((p) => p.studio === FOLDER[key]);
  const own: Shot[] = mine.map((p) => ({ src: frame(p.images[0]), widths: p.images[0].widths, name: p.name, slug: p.slug })).slice(0, PER_STUDIO);
  if (own.length >= PER_STUDIO) return own;

  const spare: Shot[] = mine.flatMap((p) => p.images.slice(1).map((im) => ({ src: frame(im), widths: im.widths, name: p.name, slug: p.slug })));
  const taken = new Set(own.concat(spare).map((s) => s.src));
  const rest = everything.filter((s) => !taken.has(s.src));
  const want = PER_STUDIO - own.length - spare.length;
  const spread: Shot[] = [];
  for (let k = 0; k < want && rest.length; k++) {
    spread.push(rest[Math.floor((k * rest.length) / Math.max(want, 1))]);
  }
  return own.concat(spare, spread).slice(0, PER_STUDIO);
};

/** light, dark, light: each panel arrives as its own place */
const grounds = ['light', 'dark', 'light'] as const;
---
{content.items.length > 0 && (
  <div class="studios">
    <header class="head" data-theme="light">
      <!-- the thread the handover above leaves off with, carried down through
           the title to the first studio -->
      <span class="thread" data-thread aria-hidden="true"></span>
      <h2 data-blur-in>{content.title}</h2>
      <p class="intro" data-rise style="--i: 1">{content.intro}</p>
      <span class="thread" data-thread aria-hidden="true"></span>
    </header>

    <!-- the stack carries a ground from the start: the nav reads the page's
         themed sections once, before any script has run, so a ground the
         stack only gave itself later was never read at all -->
    <!-- `#studios` lands here, on the first panel filling the screen, not on
         the heading above it: the nav's link is to the studios themselves -->
    <div class="stack" id="studios" data-studio-stack data-theme="light" style={`--n: ${content.items.length}`}>
    {content.items.map((s, i) => {
      const shots = reelFor(s.key);
      return (
        <section class="studio" data-studio-panel data-panel={grounds[i % grounds.length]}
                 data-theme={grounds[i % grounds.length]}
                 style={`--z: ${content.items.length - i}`} aria-labelledby={`studio-${s.key}`}>
          <div class="top">
            <div class="mark">
              <h3 id={`studio-${s.key}`} data-blur-in>{s.name}</h3>
              <!-- the number follows the name, raised at its last word -->
              <span class="n" data-rise>{String(i + 1).padStart(2, '0')}</span>
            </div>
            <div class="say">
              <p class="promise" data-rise style="--i: 2">{s.promise}</p>
              <p class="desc" data-rise style="--i: 3">{s.description}</p>
            </div>
          </div>

          <div class="foot">
            <!-- the work, stepped by hand; every frame opens its project -->
            <div class="reel" data-studio-reel data-reel-interval="6000" data-rise style="--i: 1">
              <!-- the same instrument as the statement and the client stories:
                   the arrows and the count, then the bar, over the thing it
                   is measuring -->
              <div class="reel-controls">
                <div class="reel-arrows">
                  <button type="button" data-reel-prev aria-label={`Previous ${s.name} project`} data-tap>&#8592;</button>
                  <button type="button" data-reel-next aria-label={`Next ${s.name} project`} data-tap>&#8594;</button>
                </div>
                <!-- the name of the project on show, between the arrows and
                     the count; the script rewrites it as the reel turns -->
                <span class="reel-name label" data-reel-name aria-live="polite">{shots[0]?.name}</span>
                <span class="reel-count label"><span data-reel-now>01</span>/{String(shots.length).padStart(2, '0')}</span>
              </div>
              <div class="reel-track" aria-hidden="true"><i data-reel-fill></i></div>
              <div class="band">
                {shots.map((shot, k) => (
                  <a class="frame" href={`/work/${shot.slug}`} data-reel-frame data-reel-frame-name={shot.name} data-tap
                     data-cursor-hover data-cursor-text="Explore project"
                     aria-label={`${shot.name} — ${s.name}`}>
                    <picture>
                      <source srcset={ladder(shot, 'avif')} sizes={REEL_SIZES} type="image/avif" />
                      <img src={`${shot.src}-${shot.widths[1] ?? shot.widths[0]}.webp`} srcset={ladder(shot, 'webp')} sizes={REEL_SIZES}
                           alt="" loading={k === 0 ? 'eager' : 'lazy'} decoding="async" />
                    </picture>
                  </a>
                ))}
              </div>

            </div>

            <!-- what the studio does, and the way into all of it -->
            <div class="does" data-rise style="--i: 2">
              <p class="label tag">What we do</p>
              <ul class="services">
                {s.services.map((x) => <li>{x}</li>)}
              </ul>
              <Button class="all" href={`/work?studio=${s.key}`} label={`See all ${s.name} work`} wide />
            </div>
          </div>
        </section>
      );
    })}
    </div>
  </div>
)}

<style>
  /* the head sits inside the light section, which holds the page margins; the
     panels below break out of them and hold their own */
  .head { display: flex; flex-direction: column; align-items: center;
          text-align: center; padding-bottom: 2vh; }
  /* The same weight as every other rule on the site, and the same length
     above the name as below it. It is drawn downward from the scroll — the
     choreography writes --draw — so it reads as the line above carrying on
     rather than as a divider arriving. Without script it is simply there. */
  .thread { width: var(--hairline); height: 11vh; background: var(--line);
            transform-origin: top; transform: scaleY(var(--draw, 1)); }
  h2 { margin: var(--s-6) 0 var(--s-4); font-size: var(--t-h2);
       font-weight: var(--w-display); line-height: var(--lh-display);
       letter-spacing: var(--track-display); color: var(--ink); white-space: nowrap; }
  /* wide enough for the line to set in two on a desktop; it narrows again
     with the screen and takes the lines it needs there */
  .intro { max-width: 64ch; margin: 0 0 var(--s-6); text-wrap: balance; font-size: var(--t-lead);
           line-height: var(--lh-lead); letter-spacing: var(--track-lead);
           color: var(--ink-3); }

  /* ── the stack ───────────────────────────────────────────────────────
     As tall as the panels it holds, so there is a screen of scroll for each
     handover. Without script — or on a phone, or for a reader who asked for
     less motion — it is not a stack at all: the panels simply follow one
     another, which is the same section read the long way. */
  .stack[data-live] { height: calc(var(--n) * 100svh); position: relative; }
  .stack[data-live] .studio { position: sticky; top: 0; height: 100svh; z-index: var(--z);
                              will-change: transform; }
  /* Every panel has to be pinned at once, and sticky only pins a thing within
     its own place in the flow — the second panel would not pin until a whole
     screen had been scrolled, so the first would be cut away to reveal nothing
     behind it. Pulling each one back over the last puts all three at the same
     place in the flow, and the stack's own height is what holds the scroll
     open. */
  .stack[data-live] .studio + .studio { margin-top: -100svh; }

  /* ── a panel ─────────────────────────────────────────────────────────
     A screen each, its content pinned to the top and the foot with the
     middle left empty, and its own ground under it. It breaks the page's
     margins because the ground has to reach the edges — three panels of
     different colour inside a gutter would be three stripes. */
  /* the thread from the head lands on a rule, not on an open panel */
  .stack .studio:first-child { border-top: var(--hairline) solid var(--line); }
  /* …and the last one hands over to the client stories on one too: the two
     share a ground, so without it the panel simply runs on into the quotes */
  .stack .studio:last-child { border-bottom: var(--hairline) solid var(--line); }
  .studio { min-height: 100svh; display: flex; flex-direction: column;
            justify-content: space-between; gap: var(--s-8);
            margin-inline: calc(var(--page-x) * -1);
            /* the head clears the nav — its height, plus air — rather than the
               page margin alone, because on a panel that fills the screen the
               nav is sitting right on top of it */
            padding: calc(var(--nav-y) * 2 + var(--pill-h) + 2vh) var(--page-x) var(--page-y);
            background: var(--ground); color: var(--ink); }

  .top, .foot { display: grid; grid-template-columns: minmax(0, 42%) minmax(0, 1fr);
                column-gap: var(--s-8); }
  /* the two columns are one height — the reel's — so the label at the head
     of the list sits level with the reel's controls and the slab at its foot
     sits level with the picture's bottom edge */
  .foot { align-items: stretch; }

  /* the number and the name, one over the other and the same size: the panel
     says which of three it is before it says anything else */
  .mark { display: flex; flex-direction: column; }
  .n, .mark h3 { font-size: var(--t-h2); font-weight: var(--w-display);
                 line-height: var(--lh-display); letter-spacing: var(--track-display); }
  .n { color: var(--ink-3); }
  .mark h3 { margin: 0; color: var(--ink); }
  /* The name runs as a line of text and the number follows its last
     word, small and raised like a footnote — wherever that line ends. The
     sizes are forced so the rules for smaller screens below do not undo it. */
  .mark { display: block; text-wrap: balance; }
  .mark h3 { display: inline; }
  .mark .n { display: inline-block; vertical-align: top; margin-left: 0.45em;
             font-size: var(--t-lead) !important; line-height: 1;
             font-stretch: var(--label-stretch); font-weight: var(--w-label);
             letter-spacing: var(--track-label); padding-top: 0.25em; }

  /* The studio's line is a sentence, so it takes the statement's voice — the
     one the manifesto speaks in: normal case, regular, at the statement's
     size — and leaves the capitals to the name beside it. */
  .promise { margin: 0 0 var(--s-5); max-width: 22ch; font-size: var(--t-statement);
             font-weight: var(--w-title); line-height: 1.2;
             letter-spacing: var(--track-title); color: var(--ink); }
  .desc { margin: 0; max-width: 46ch; font-size: var(--t-body);
          line-height: var(--lh-body); color: var(--ink-2); }

  /* ── the reel ──────────────────────────────────────────────────────── */
  /* The panel is one screen tall and the picture is a share of the panel's
     width, so on a wide, short screen the picture alone could be taller
     than the room left under the head. The reel is capped by the screen's
     height instead — the picture may take this much of it and no more —
     and its width follows, so the bar over it stays exactly as wide as
     the picture it measures. */
  .reel { --reel-h: 40svh; }
  /* only where the panel is a screen: stacked on a phone or a tablet it runs
     at its own height and the picture simply takes the column */
  @media (min-width: 860px) { .reel { width: min(100%, calc(var(--reel-h) * 1.5)); } }
  /* a step down from the bar: the bar measures the band, it does not sit on it */
  .band { position: relative; margin-top: var(--s-4); aspect-ratio: 3 / 2; overflow: hidden;
          background: var(--glass); border-radius: var(--radius-media); }
  .frame { position: absolute; inset: 0; display: block; clip-path: inset(0 0 0 100%); }
  .frame:first-of-type { clip-path: inset(0 0 0 0); }
  .frame picture, .frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* Under the pointer the band draws back a touch while the picture inside
     it grows — the work grid's move, without its arrow: the two run in
     opposite directions, and the picture's is the slower, which is what
     makes it read as depth rather than as a hover state. */
  .band { transition: transform 0.6s var(--ease-out); }
  .frame img { transition: transform 1.4s var(--ease-out); }
  @media (hover: hover) and (pointer: fine) {
    .band:hover { transform: scale(0.985); }
    .band:hover .frame img { transform: scale(1.06); }
  }
  @media (prefers-reduced-motion: reduce) {
    .band, .frame img { transition: none; }
    .band:hover, .band:hover .frame img { transform: none; }
  }
  /* the project's name, on the picture, so a click is never a guess: the
     site's chip, on the site's glass */
  /* the name sits in the instrument, not on the picture: the picture stays
     a picture, and the row above it already reads as "where you are" */
  /* the same label as the count beside it — size, tracking, case, grey — so
     the two sit on one baseline and read as one readout */
  .reel-name { min-width: 0; overflow: hidden; white-space: nowrap; text-overflow: ellipsis;
               margin-left: auto; padding: 0 var(--s-4); text-align: right;
               color: var(--ink-4); }


  /* ── what it does ──────────────────────────────────────────────────── */
  .does { display: flex; flex-direction: column; justify-content: space-between; }
  .tag { color: var(--ink-3); margin: 0 0 var(--s-4); }
  .services { list-style: none; margin: 0; padding: 0; }
  /* a rule under each, the way the questions are ruled: a list of what is on
     offer reads as a list, where a row of pills reads as metadata */
  .services li { padding: var(--s-4) 0; font-size: var(--t-lead);
                 line-height: var(--lh-title); color: var(--ink);
                 border-bottom: var(--hairline) solid var(--line); }

  /* the way into the rest of it */
  .all { margin-top: var(--s-5); }

  @media (max-width: 1099px) {
    .top, .foot { column-gap: var(--s-7); }
  }
  /* A short screen — a laptop with the bar showing, or any window much
     wider than it is tall, where the type has grown with the width and the
     height has not — has less room under the nav than the panel was drawn
     for. The heads come down a size, the air between head and foot closes
     up, and the picture takes a smaller share of the height, so the panel
     still holds its four corners without anything leaving the frame. */
  @media (min-width: 860px) and ((max-height: 820px) or (min-aspect-ratio: 2 / 1)) {
    .studio { gap: var(--s-6); padding-top: calc(var(--nav-y) * 2 + var(--pill-h) + 1vh); }
    .n, .mark h3 { font-size: var(--t-h3); }
    .promise { font-size: var(--t-title); margin-bottom: var(--s-3); }
    .reel { --reel-h: 32svh; }
    .services li { padding-block: var(--s-2); }
  }
  @media (min-width: 860px) and (max-height: 640px) {
    .desc { display: none; }
    .reel { --reel-h: 28svh; }
  }

  /* Stacked: the panel is no longer a screen with a void in it — on a phone
     the void is just a blank screen — so it becomes a block that runs at its
     own height, in the same order. */
  @media (max-width: 859px) {
    .studio { min-height: 0; gap: var(--s-7); padding: var(--section-y) var(--page-x); }
    .top, .foot { grid-template-columns: 1fr; row-gap: var(--s-6); }
    .n, .mark h3 { font-size: var(--t-h3); }
    .promise { font-size: var(--t-title); }
    .desc, .promise { max-width: none; }
    h2 { white-space: normal; }
    .thread { height: 8vh; }
  }
  /* the section's name steps down a size only on a phone: a tablet has the
     width for it at full size, stacked */
  @media (max-width: 719px) {
    h2 { font-size: var(--t-h3); }
  }
</style>
