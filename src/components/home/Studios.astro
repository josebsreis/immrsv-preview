---
/** The three studios, one full screen each.
 *
 *  A studio is a panel, not a card: its number and name at the top left, what
 *  it promises and what that means at the top right, its work at the bottom
 *  left and what it does at the bottom right — with the middle left empty.
 *  The void is the point. Pinning the content to the top and the foot of the
 *  screen is what makes three sections of the same shape read as three of one
 *  thing rather than as a list, and it is the one layout that a practice
 *  selling precision can hold without looking sparse.
 *
 *  The grounds alternate — light, dark, light — so each panel arrives as its
 *  own place. And they are stacked rather than laid end to end: all three are
 *  pinned to the top of the screen with the first one covering, and scrolling
 *  lifts it, whole, off the top to leave the one beneath. Nothing arrives;
 *  something is taken away (scripts/ui/studioStack.ts).
 *
 *  The work is links now. Each frame opens the project it shows, which is why
 *  nothing in the reel follows the pointer — see scripts/ui/studioReel.ts. */
import type { HomeContent } from '@lib/sanity/types';
import work from '../../content/work.generated.json';

interface Props { content: HomeContent['studios']; }
const { content } = Astro.props;

/* The studios' own work, as delivered by the client and squeezed down by
   scripts/images.mjs. */
const FOLDER: Record<string, string> = { architecture: 'architecture-design', media: 'creative-media', products: 'digital-products' };
/** every panel carries the same count, so the three reels read as three of
 *  one thing rather than as three different amounts of work */
const PER_STUDIO = 4;
type Shot = { src: string; name: string; slug: string };
type Delivered = { studio: string; name: string; slug: string; images: { src: string; widths: number[] }[] };
const projects = work as Delivered[];
/** the reel is a band about a third of the page wide: the card width is plenty */
const frame = (im: { src: string; widths: number[] }) => `${im.src}-${im.widths[0]}`;
/** every render there is, in delivery order */
const everything: Shot[] = projects.flatMap((p) => p.images.map((im) => ({ src: frame(im), name: p.name, slug: p.slug })));

/**
 * A studio's four frames: its own projects first, one frame each. A studio
 * with fewer than four borrows — its own spare renders before anyone else's,
 * then work from across the practice, spread through the pool rather than
 * taken off the top so the borrowed frames are not all the same building.
 * Stand-ins until the client sends the rest; nothing here is invented.
 */
const reelFor = (key: string): Shot[] => {
  const mine = projects.filter((p) => p.studio === FOLDER[key]);
  const own: Shot[] = mine.map((p) => ({ src: frame(p.images[0]), name: p.name, slug: p.slug })).slice(0, PER_STUDIO);
  if (own.length >= PER_STUDIO) return own;

  const spare: Shot[] = mine.flatMap((p) => p.images.slice(1).map((im) => ({ src: frame(im), name: p.name, slug: p.slug })));
  const taken = new Set(own.concat(spare).map((s) => s.src));
  const rest = everything.filter((s) => !taken.has(s.src));
  const want = PER_STUDIO - own.length - spare.length;
  const spread: Shot[] = [];
  for (let k = 0; k < want && rest.length; k++) {
    spread.push(rest[Math.floor((k * rest.length) / Math.max(want, 1))]);
  }
  return own.concat(spare, spread).slice(0, PER_STUDIO);
};

/** light, dark, light: each panel arrives as its own place */
const grounds = ['light', 'dark', 'light'] as const;
---
{content.items.length > 0 && (
  <div class="studios" id="studios">
    <header class="head" data-theme="light">
      <!-- the thread the handover above leaves off with, carried down through
           the title to the first studio -->
      <span class="thread" data-thread aria-hidden="true"></span>
      <h2 data-rise>{content.title}</h2>
      <p class="intro" data-rise style="--i: 1">{content.intro}</p>
      <span class="thread" data-thread aria-hidden="true"></span>
    </header>

    <div class="stack" data-studio-stack style={`--n: ${content.items.length}`}>
    {content.items.map((s, i) => {
      const shots = reelFor(s.key);
      return (
        <section class="studio" data-studio-panel data-panel={grounds[i % grounds.length]}
                 style={`--z: ${content.items.length - i}`} aria-labelledby={`studio-${s.key}`}>
          <div class="top">
            <div class="mark">
              <span class="n" data-rise>{String(i + 1).padStart(2, '0')}</span>
              <h3 id={`studio-${s.key}`} data-rise style="--i: 1">{s.name}</h3>
            </div>
            <div class="say">
              <p class="promise" data-rise style="--i: 2">{s.promise}</p>
              <p class="desc" data-rise style="--i: 3">{s.description}</p>
            </div>
          </div>

          <div class="foot">
            <!-- the work, stepped by hand; every frame opens its project -->
            <div class="reel" data-studio-reel data-rise style="--i: 1">
              <div class="band">
                {shots.map((shot, k) => (
                  <a class="frame" href={`/work/${shot.slug}`} data-reel-frame data-tap
                     aria-label={`${shot.name} — ${s.name}`}>
                    <picture>
                      <source srcset={`${shot.src}.avif`} type="image/avif" />
                      <img src={`${shot.src}.webp`} alt={shot.name}
                           loading={k === 0 ? 'eager' : 'lazy'} decoding="async" />
                    </picture>
                    <span class="cap label">{shot.name}</span>
                  </a>
                ))}
              </div>

              <div class="controls">
                <div class="arrows">
                  <button type="button" data-reel-prev aria-label={`Previous ${s.name} project`} data-tap>&#8592;</button>
                  <button type="button" data-reel-next aria-label={`Next ${s.name} project`} data-tap>&#8594;</button>
                </div>
                <div class="roll" aria-hidden="true">
                  <span class="rail"><b class="fill" data-reel-fill></b></span>
                  <span class="ticks">{shots.map(() => <i class="tick" data-reel-step></i>)}</span>
                </div>
                <span class="count label"><span data-reel-now>01</span>/{String(shots.length).padStart(2, '0')}</span>
              </div>
            </div>

            <!-- what the studio does, and the way into all of it -->
            <div class="does" data-rise style="--i: 2">
              <p class="label tag">What we do</p>
              <ul class="services">
                {s.services.map((x) => <li>{x}</li>)}
              </ul>
              <a class="all" href={`/work?studio=${s.key}`} data-tap data-dhover-item data-axis="x">
                <span class="tile" data-dhover-tile aria-hidden="true"></span>
                <b>See all {s.name} work</b>
                <i class="arrow" aria-hidden="true">&#8594;</i>
              </a>
            </div>
          </div>
        </section>
      );
    })}
    </div>
  </div>
)}

<style>
  /* the head sits inside the light section, which holds the page margins; the
     panels below break out of them and hold their own */
  .head { display: flex; flex-direction: column; align-items: center;
          text-align: center; padding-bottom: 2vh; }
  /* The same weight as every other rule on the site, and the same length
     above the name as below it. It is drawn downward from the scroll — the
     choreography writes --draw — so it reads as the line above carrying on
     rather than as a divider arriving. Without script it is simply there. */
  .thread { width: var(--hairline); height: 11vh; background: var(--line);
            transform-origin: top; transform: scaleY(var(--draw, 1)); }
  h2 { margin: var(--s-6) 0 var(--s-4); font-size: var(--t-h2);
       font-weight: var(--w-display); line-height: var(--lh-display);
       letter-spacing: var(--track-display); color: var(--ink); white-space: nowrap; }
  .intro { max-width: 42ch; margin: 0 0 var(--s-6); font-size: var(--t-lead);
           line-height: var(--lh-lead); letter-spacing: var(--track-lead);
           color: var(--ink-3); }

  /* ── the stack ───────────────────────────────────────────────────────
     As tall as the panels it holds, so there is a screen of scroll for each
     handover. Without script — or on a phone, or for a reader who asked for
     less motion — it is not a stack at all: the panels simply follow one
     another, which is the same section read the long way. */
  .stack[data-live] { height: calc(var(--n) * 100svh); position: relative; }
  .stack[data-live] .studio { position: sticky; top: 0; height: 100svh; z-index: var(--z);
                              will-change: transform; }
  /* Every panel has to be pinned at once, and sticky only pins a thing within
     its own place in the flow — the second panel would not pin until a whole
     screen had been scrolled, so the first would be cut away to reveal nothing
     behind it. Pulling each one back over the last puts all three at the same
     place in the flow, and the stack's own height is what holds the scroll
     open. */
  .stack[data-live] .studio + .studio { margin-top: -100svh; }

  /* ── a panel ─────────────────────────────────────────────────────────
     A screen each, its content pinned to the top and the foot with the
     middle left empty, and its own ground under it. It breaks the page's
     margins because the ground has to reach the edges — three panels of
     different colour inside a gutter would be three stripes. */
  /* the thread from the head lands on a rule, not on an open panel */
  .stack .studio:first-child { border-top: var(--hairline) solid var(--line); }
  .studio { min-height: 100svh; display: flex; flex-direction: column;
            justify-content: space-between; gap: var(--s-8);
            margin-inline: calc(var(--page-x) * -1);
            /* the head clears the nav — its height, plus air — rather than the
               page margin alone, because on a panel that fills the screen the
               nav is sitting right on top of it */
            padding: calc(var(--nav-y) * 2 + var(--pill-h) + 5vh) var(--page-x) var(--page-y);
            background: var(--ground); color: var(--ink); }

  .top, .foot { display: grid; grid-template-columns: minmax(0, 42%) minmax(0, 1fr);
                column-gap: var(--s-8); }
  .foot { align-items: end; }

  /* the number and the name, one over the other and the same size: the panel
     says which of three it is before it says anything else */
  .mark { display: flex; flex-direction: column; }
  .n, .mark h3 { font-size: var(--t-h2); font-weight: var(--w-display);
                 line-height: var(--lh-display); letter-spacing: var(--track-display); }
  .n { color: var(--ink-4); }
  .mark h3 { margin: 0; color: var(--ink); }

  .promise { margin: 0 0 var(--s-5); max-width: 20ch; font-size: var(--t-h3);
             font-weight: var(--w-display); line-height: var(--lh-title);
             letter-spacing: var(--track-title); color: var(--ink); }
  .desc { margin: 0; max-width: 46ch; font-size: var(--t-body);
          line-height: var(--lh-body); color: var(--ink-2); }

  /* ── the reel ──────────────────────────────────────────────────────── */
  .band { position: relative; aspect-ratio: 3 / 2; overflow: hidden;
          background: var(--glass); border-radius: var(--radius-media); }
  .frame { position: absolute; inset: 0; display: block; clip-path: inset(0 0 100% 0); }
  .frame:first-of-type { clip-path: inset(0 0 0 0); }
  .frame picture, .frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
  /* the project's name, on the picture, so a click is never a guess */
  .cap { position: absolute; left: var(--s-4); bottom: var(--s-4);
         padding: 0.4rem 0.6rem; color: #fff; background: rgb(0 0 0 / 0.32);
         -webkit-backdrop-filter: blur(10px); backdrop-filter: blur(10px);
         border-radius: var(--radius); }

  .controls { display: flex; align-items: center; gap: var(--s-5); margin-top: var(--s-4); }
  .arrows { display: flex; gap: var(--s-4); }
  .arrows button { font-size: var(--t-body); line-height: 1; color: var(--ink-3);
                   background: none; border: 0; cursor: pointer;
                   transition: color var(--dur-fast) ease; }
  .arrows button:hover { color: var(--ink); }
  /* the bar says how far through, the squares say which one — and the bar is
     drawn between them rather than under them, so the two never overlap */
  .roll { position: relative; flex: 1; height: var(--square); }
  .rail { position: absolute; inset: 50% var(--square) auto; height: var(--hairline);
          translate: 0 -50%; background: var(--line-strong); }
  .fill { position: absolute; inset: 0; transform-origin: left; transform: scaleX(0);
          background: var(--ink); transition: transform var(--dur-slow) var(--ease-out); }
  .ticks { position: absolute; inset: 0; display: flex; justify-content: space-between; }
  .tick { width: var(--square); height: var(--square); background: var(--ink-dim);
          cursor: pointer; transition: background var(--dur-fast) ease, scale var(--dur-fast) ease; }
  .tick.on { background: var(--ink); scale: 1.5; }
  .count { color: var(--ink-4); font-variant-numeric: tabular-nums; }

  /* ── what it does ──────────────────────────────────────────────────── */
  .does { display: flex; flex-direction: column; }
  .tag { color: var(--ink-3); margin: 0 0 var(--s-4); }
  .services { list-style: none; margin: 0 0 var(--s-5); padding: 0; }
  /* a rule under each, the way the questions are ruled: a list of what is on
     offer reads as a list, where a row of pills reads as metadata */
  .services li { padding: var(--s-4) 0; font-size: var(--t-lead);
                 line-height: var(--lh-title); color: var(--ink);
                 border-bottom: var(--hairline) solid var(--line); }

  /* the way into the rest of it: the page's ink as a slab, its ground as the
     letters, so it inverts with the panel it is on */
  .all { position: relative; overflow: hidden; display: flex; align-items: center;
         justify-content: space-between; gap: var(--s-5);
         padding: var(--s-5); background: var(--ink); color: var(--ground);
         border-radius: var(--radius); }
  .all b { font-weight: var(--w-ui); font-size: var(--t-body); }
  .all .arrow { font-style: normal; transition: translate var(--dur-base) var(--ease-out); }
  .all:hover .arrow { translate: 0.35rem 0; }
  .all .tile { position: absolute; inset: 0; background: rgb(255 255 255 / 0.12);
               transform: translateX(-100%); will-change: transform;
               transition: transform var(--dur-base) var(--ease-panel); }
  .all b, .all .arrow { position: relative; }

  @media (max-width: 1099px) {
    .top, .foot { column-gap: var(--s-7); }
  }

  /* Stacked: the panel is no longer a screen with a void in it — on a phone
     the void is just a blank screen — so it becomes a block that runs at its
     own height, in the same order. */
  @media (max-width: 859px) {
    .studio { min-height: 0; gap: var(--s-7); padding: 12vh var(--page-x); }
    .top, .foot { grid-template-columns: 1fr; row-gap: var(--s-6); }
    .n, .mark h3 { font-size: var(--t-h3); }
    .promise { font-size: var(--t-title); }
    .desc, .promise { max-width: none; }
    h2 { white-space: normal; font-size: var(--t-h3); }
    .thread { height: 8vh; }
  }
</style>
