---
/** The three studios, read as one section: the number and the service list on
 *  the left, the name and what it means on the right, and a wide media band
 *  under each. The clips are silent loops that only run on screen
 *  (scripts/ui/videoInView.ts). */
import type { HomeContent } from '@lib/sanity/types';
import work from '../../content/work.generated.json';

interface Props { content: HomeContent['studios']; }
const { content } = Astro.props;

/* The studios' own work, as delivered by the client and squeezed down by
   scripts/images.mjs. Where a studio has projects, its card shows them one at
   a time instead of a stock clip; where it has none yet, the clip stands. */
const FOLDER: Record<string, string> = { architecture: 'architecture-design', media: 'creative-media', products: 'digital-products' };
/** every card carries the same count, so the three reels turn at the same
 *  pace and the section reads as three of one thing */
const PER_STUDIO = 4;
type Shot = { src: string; name: string };
const projects = work as { studio: string; name: string; images: string[] }[];
/** every render there is, in delivery order */
const everything: Shot[] = projects.flatMap((p) => p.images.map((src) => ({ src, name: p.name })));

/**
 * A studio's four frames: its own projects first, one frame each. A studio
 * with fewer than four borrows — its own spare renders before anyone else's,
 * then work from across the practice, spread through the pool rather than
 * taken off the top so the borrowed frames are not all the same building.
 * Stand-ins until the client sends the rest; nothing here is invented.
 */
const reelFor = (key: string): Shot[] => {
  const mine = projects.filter((p) => p.studio === FOLDER[key]);
  const own: Shot[] = mine.map((p) => ({ src: p.images[0], name: p.name })).slice(0, PER_STUDIO);
  if (own.length >= PER_STUDIO) return own;

  const spare: Shot[] = mine.flatMap((p) => p.images.slice(1).map((src) => ({ src, name: p.name })));
  const taken = new Set(own.concat(spare).map((s) => s.src));
  const rest = everything.filter((s) => !taken.has(s.src));
  const want = PER_STUDIO - own.length - spare.length;
  const spread: Shot[] = [];
  for (let k = 0; k < want && rest.length; k++) {
    spread.push(rest[Math.floor((k * rest.length) / Math.max(want, 1))]);
  }
  return own.concat(spare, spread).slice(0, PER_STUDIO);
};
---
{content.items.length > 0 && (
  <section class="studios" id="studios">
    <header class="head">
      <p class="tag"><span class="sq" aria-hidden="true"></span>{content.tag}</p>
      <p class="intro" data-rise>{content.intro}</p>
    </header>

    {content.items.map((s, i) => (
      <article class="studio" data-reel>
        <span class="n label">{String(i + 1).padStart(2, '0')}</span>
        <div class="words">
          <h3 data-rise>{s.name}</h3>
          <p class="desc" data-rise style="--i: 1">{s.description}</p>
          <div class="services" data-marquee data-marquee-speed="24" data-marquee-drag="0.7">
            <div class="svc-track" data-marquee-track aria-hidden="true">
              <div class="svc-run">
                {s.services.map((x) => <span class="svc"><i class="sq" aria-hidden="true"></i>{x}</span>)}
              </div>
            </div>
            <p class="sr">{s.services.join(', ')}.</p>
          </div>
        </div>

        <div class="band" style={`--n: ${reelFor(s.key).length}`}>
            {reelFor(s.key).map((shot, k) => (
              <picture class="frame" data-reel-frame={shot.name}>
                <source srcset={`${shot.src}.avif`} type="image/avif" />
                <img src={`${shot.src}.webp`} alt={`${shot.name} — ${s.name}`}
                     loading={k === 0 ? 'eager' : 'lazy'} decoding="async" />
              </picture>
            ))}
            <span class="roll" aria-hidden="true">
              <b class="fill" data-reel-fill></b>
              {reelFor(s.key).map(() => <i class="tick" data-reel-step></i>)}
            </span>
          </div>
      </article>
    ))}
  </section>
)}

<style>
  /* it sits inside the light section, which already holds the page margins */
  .studios { position: relative; padding-bottom: 16vh; }

  .head { display: grid; grid-template-columns: minmax(0, var(--col-side)) minmax(0, 1fr);
          column-gap: var(--col-gap); align-items: start; }
  .tag { display: flex; align-items: center; gap: 0.75rem; font-size: var(--t-body); color: var(--ink); }
  .tag :global(.sq) { color: var(--ink-4); }
  .intro { max-width: 34ch; font-size: var(--t-lead); line-height: 1.45; color: var(--ink-2); }

  .studio { padding-top: 12vh; }
  .n { display: block; color: var(--ink-4); }
  h3 { font-size: var(--t-statement); font-weight: 500; line-height: 1.05;
       letter-spacing: -0.025em; color: var(--ink); }
  /* a weight up on the description too: at this size regular sits back too far
     from the name above it. The number and the services keep theirs. */
  .desc { margin-top: var(--s-5); max-width: 46ch; font-size: var(--t-body); font-weight: 500;
          line-height: 1.6; color: var(--ink-2); }
  /* the services run rather than stack: five lines of small caps under a
     paragraph was a second block of text where a footnote was wanted. It runs
     the width of the words and stops where the clip starts. */
  .services { position: relative; margin-top: var(--s-6); overflow: hidden; }
  .svc-track { display: flex; width: max-content; will-change: transform; }
  .svc-run { display: flex; flex: none; }
  .svc { display: flex; align-items: center; gap: 0.7rem; padding-right: 0.7rem; white-space: nowrap;
         font-size: var(--t-caption); letter-spacing: 0.12em; text-transform: uppercase; color: var(--ink-3); }
  .svc .sq { flex: none; width: var(--square); height: var(--square); background: var(--marker); }
  .sr { position: absolute; width: 1px; height: 1px; margin: -1px; padding: 0;
        overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  .band { position: relative; margin-top: var(--s-6); }

  /* the clip fills its frame whatever shape it arrived in: the renders are
     not one ratio, and a band with letterboxing in it is not a band */
  .band video, .band img { width: 100%; height: 100%; object-fit: cover; display: block; }

  /* Every frame is stacked on the same spot, the first included: a change
     opens a clip from the edge the reel is travelling from, over the frame
     before it, which is still sitting underneath. The band carries its own
     height, so no frame has to stay in flow to give it one. */
  .frame { position: absolute; inset: 0; clip-path: inset(0 0 100% 0); }
  .frame:first-of-type { clip-path: inset(0 0 0 0); }

  /* The counter: a bar down the inside of the picture with a square for each
     project on it. The bar fills from the first square to where you are, and
     the square it has reached is lit — so you can see the next one coming as
     the fill closes on it. On a frosted pane, the length of its own stops,
     centred on the picture's left edge, and only while the card is the one
     being turned. */
  .roll { position: absolute; top: 50%; translate: 0 -50%; left: var(--s-4);
          width: 1.4rem; height: 7.5rem;
          z-index: 30; pointer-events: none; padding: 0.6rem 0;
          display: grid; grid-template-rows: repeat(var(--n, 1), 1fr);
          background: rgb(0 0 0 / 0.26); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px);
          opacity: 0; transition: opacity 0.25s ease; }
  .studio.hovering .roll { opacity: 1; }
  /* the track runs from the centre of the first stop to the centre of the
     last, and the fill is laid along the same line by the script */
  .roll::before { content: ''; position: absolute; left: 50%; translate: -50% 0; width: var(--hairline);
                  top: calc(0.6rem + (100% - 1.2rem) / var(--n, 1) / 2);
                  bottom: calc(0.6rem + (100% - 1.2rem) / var(--n, 1) / 2);
                  background: rgb(255 255 255 / 0.3); }
  .fill { position: absolute; left: 50%; translate: -50% 0; width: 2px; height: 0;
          top: calc(0.6rem + (100% - 1.2rem) / var(--n, 1) / 2);
          background: #fff; }
  .tick { position: relative; align-self: center; justify-self: center;
          width: 5px; height: 5px; background: rgb(255 255 255 / 0.55);
          transition: background-color 0.3s ease, transform 0.3s cubic-bezier(0.16, 1, 0.3, 1); }
  .tick.on { background: #fff; transform: scale(1.5); }

  /* Desktop: the words on the left, the clip on the right and out to the edge
     of the page. The card is as tall as the clip — its ratio sets the height,
     with a floor under it — so there is no padding above or below to leave a
     band of empty ground the way a fixed screen height did. The cards follow
     one another down the page; they are still pulled out to the page edges so
     the clip can reach it. */
  @media (min-width: 860px) {
    .studios { padding-bottom: 0; }
    /* The shared column gap is 18rem — it is sized for the statement layout,
       where two columns sit either side of a wide gutter, and here it starved
       the words. This card sets its own: the number close to what it numbers,
       and the clip a normal gutter away. */
    .studio { padding: 0 0 0 var(--page-x);
              display: grid; grid-template-columns: 4.5rem minmax(0, 1fr) 42%;
              column-gap: var(--s-7); align-items: center;
              margin-inline: calc(var(--page-x) * -1);
              background: var(--ground);
              border-top: var(--hairline) solid var(--line); }
    /* the number and the name start together at the top; the services are
       pushed to the foot, so the words hold both edges of the card */
    .n { align-self: start; padding-top: var(--s-6); }
    .words { align-self: stretch; display: flex; flex-direction: column;
             padding-block: var(--s-6); }
    .services { margin-top: auto; }
    /* the width is the column's, always: a ratio with a floor under it will
       otherwise widen the box to satisfy both and push the clip off the page */
    .band { margin: 0; width: 100%; align-self: stretch;
            aspect-ratio: 3 / 2; min-height: 22rem; }
  }

  @media (max-width: 859px) {
    .studios { padding-bottom: 12vh; }
    .studio { padding-top: 9vh; }
    /* stacked, nothing else gives the band a height: the frames are all
       absolute, so the ratio is what holds it open */
    .band { aspect-ratio: 3 / 2; }
    .promise, .desc, .intro { max-width: none; }
  }
</style>
