---
/** The name at full width, drawn rather than set: a hairline outline whose
 *  letters are separate objects. Touching one shoves it along the pointer's
 *  travel, spins it about its centre and fills it; a spring returns it and the
 *  fill drains. Behaviour lives in scripts/ui/wordmarkLetters.ts. */
import { LETTERMARK } from '@lib/lettermark';
---
<section class="panel" aria-label="IMMRSV">
  <div class="mark arrives" data-wordmark style="--arrive-delay: .2s">
    <svg viewBox={LETTERMARK.viewBox} role="img" aria-label="IMMRSV">
      {LETTERMARK.paths.map((d) => <path class="ltr" data-letter d={d} />)}
    </svg>
  </div>
</section>

<style>
  /* it follows the hero closely — the name lands as soon as the hero leaves */
  .panel { position: relative; z-index: var(--z-ui);
           display: grid; place-items: center; padding: 8vh var(--page-x); }
  .mark { position: relative; width: 100%; color: var(--ink); }
  svg { width: 100%; height: auto; display: block; overflow: visible; }

  /* outline at rest, a true hairline at any scale; the interior is the target */
  .ltr {
    fill: currentColor; fill-opacity: 0;
    stroke: currentColor; stroke-width: 1px; vector-effect: non-scaling-stroke;
    stroke-opacity: 0.55;
    pointer-events: fill;
    transform-box: fill-box; transform-origin: 50% 50%;
    /* touched: fills at once. left alone: drains */
    transition: fill-opacity 0.9s ease 0.15s, stroke-opacity var(--dur-base) ease;
  }
  .ltr.lit { fill-opacity: 1; stroke-opacity: 1; transition: fill-opacity 0.1s linear, stroke-opacity 0.1s linear; }

  /* nothing to shove without a pointer, so the mark simply stands solid */
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .ltr { fill-opacity: 1; stroke-opacity: 1; }
  }
  @media (max-width: 719px) { .panel { padding: 0 1.25rem; } }
</style>
