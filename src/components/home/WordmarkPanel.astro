---
/** The name at full width, drawn rather than set: a hairline outline whose
 *  letters are separate objects. Touching one shoves it along the pointer's
 *  travel, spins it about its centre and lights it at once; a spring returns
 *  it and the light fades back off.
 *  Behaviour lives in scripts/ui/wordmarkLetters.ts. */
import { LETTERMARK } from '@lib/lettermark';

/** outline: draw the mark itself, or leave the name to the particles alone.
 *  With it off the SVG stays in the page for assistive tech but paints
 *  nothing, and the letters no longer answer the cursor. */
interface Props { outline?: boolean; }
const { outline = false } = Astro.props;
---
<section class="panel" aria-label="IMMRSV">
  <div class="mark arrives" data-wordmark data-outline={outline ? 'on' : 'off'} style="--arrive-delay: .2s">
    <svg viewBox={LETTERMARK.viewBox} role="img" aria-label="IMMRSV">
      {LETTERMARK.paths.map((d) => <path class="ltr" data-letter d={d} />)}
    </svg>
  </div>
</section>

<style>
  /* it follows the hero closely — the name lands as soon as the hero leaves */
  .panel { position: relative; z-index: var(--z-ui);
           display: grid; place-items: center; padding: 8vh var(--page-x); }
  .mark { position: relative; width: 100%; color: var(--ink); }
  svg { width: 100%; height: auto; display: block; overflow: visible; }

  /* outline at rest, a true hairline at any scale; the interior is the target */
  .ltr {
    fill: currentColor; fill-opacity: 0;
    stroke: currentColor; stroke-width: 1px; vector-effect: non-scaling-stroke;
    /* --formed is written by the choreography: 0 while the particles are still
       arriving, 1 once they have landed and the drawn mark can take over */
    stroke-opacity: calc(0.55 * var(--formed, 1));
    pointer-events: fill;
    transform-box: fill-box; transform-origin: 50% 50%;
  }
  /* letting go fades it; touching it does not — see .lit below */
  .ltr { transition: fill-opacity 0.95s ease, stroke-opacity 0.95s ease; }
  /* contact is instant — no ramp, the light is simply on */
  .ltr.lit { fill-opacity: 1; stroke-opacity: 1; transition: none; }

  /* nothing to shove without a pointer, so the mark simply stands solid */
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .ltr { fill-opacity: 1; stroke-opacity: 1; transition: none; }
  }
  /* outline off: the particles carry the name alone, and the SVG paints
     nothing anywhere — it stays only so the name is still readable to
     assistive tech */
  .mark[data-outline="off"] .ltr,
  .mark[data-outline="off"] .ltr.lit { fill-opacity: 0; stroke-opacity: 0; pointer-events: none; }
  @media (max-width: 719px) { .panel { padding: 0 var(--page-x); } }
</style>
