---
/** The questions a client asks before they commit.
 *
 *  The page's two columns again: the name of the section at the head of the
 *  narrow one and the founder at its foot — the questions are asked of a
 *  person, so the person is beside them the whole way down — with the
 *  questions themselves on the wide column.
 *
 *  A question is a row on a rule. Hovering brings a panel in from the edge the
 *  cursor crossed, the same object the nav's pills and the buttons use, but
 *  pinned to the vertical: a row this wide and this short only reads its top
 *  and bottom edges, and a panel arriving from the side of a full-width row
 *  reads as a wipe. Opening one inverts it — the row becomes the ink and the
 *  page becomes the letters — which is the strongest thing this palette can
 *  do to say "this one", and it costs no colour.
 *
 *  One at a time: an accordion that lets every panel stand open turns the
 *  section into a wall of text and loses the list. */
import type { HomeContent, Person } from '@lib/sanity/types';
import Button from '@components/ui/Button.astro';

interface Props { content: HomeContent['faqs']; person: Person; }
const { content, person } = Astro.props;
const lines = content.aside.split('\n');
---
<section class="faqs" id="faqs" data-faqs>
  <div class="aside">
    <p class="section-tag">{content.tag}</p>

    <div class="ask">
      {person.portrait && (
        <picture class="portrait">
          {person.portrait.avifSrcset && <source srcset={person.portrait.avifSrcset} sizes="7rem" type="image/avif" />}
          <img src={person.portrait.url} srcset={person.portrait.webpSrcset} sizes="7rem"
               alt={person.portrait.alt ?? person.name} width="360" height="360" loading="lazy" decoding="async" />
        </picture>
      )}
      <p class="line">{lines.map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
      <Button href={content.cta.href} label={content.cta.label} />
    </div>
  </div>

  <div class="body">
    <h2 data-blur-in>{content.title}</h2>

    <ul class="list">
      {content.items.map((item, i) => (
        <li class="item">
          <!-- the row the panel crosses; the answer below it is outside, so the
               panel never runs over an open one -->
          <div class="row" data-dhover-item data-axis="y">
            <span class="tile" data-dhover-tile aria-hidden="true"></span>
            <button class="q" type="button" aria-expanded="false" aria-controls={`faq-${i}`} data-faq-q data-tap>
              <span class="txt">{item.q}</span>
              <i class="sq" aria-hidden="true"></i>
            </button>
          </div>
          <div class="a" id={`faq-${i}`} data-faq-a>
            <div class="inner">
              {item.a.split('\n\n').map((para) => <p>{para}</p>)}
            </div>
          </div>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  /* it sits inside the light section, which already holds the page margins */
  .faqs { position: relative; padding: var(--section-y) 0; }

  /* the narrow column carries the name at its head and the founder at its
     foot, however tall the questions turn out to be */
  .aside { display: flex; flex-direction: column; justify-content: space-between;
           gap: var(--s-8); }
  .ask { display: flex; flex-direction: column; align-items: flex-start; gap: var(--s-4); }
  .portrait { display: block; width: 7rem; height: 7rem; }
  .portrait img { width: 100%; height: 100%; object-fit: cover; filter: grayscale(1);
                  border-radius: var(--radius-media); }
  .line { margin: 0; font-size: var(--t-lead); line-height: var(--lh-lead);
          letter-spacing: var(--track-lead); color: var(--ink-3); }

  /* A heading, not a statement. At the page's largest size this is three
     lines of display type over a list of seven rows, and the list — which is
     what anyone came here for — starts a screen down. */
  h2 { margin: 0 0 var(--s-7); max-width: 30ch;
       font-size: var(--t-h3); font-weight: var(--w-display);
       line-height: var(--lh-title); letter-spacing: var(--track-display);
       color: var(--ink); }

  .list { list-style: none; margin: 0; padding: 0; }
  /* the rule belongs to the row above it as much as the one below, so every
     item carries its own and the last one closes the list */
  .item { border-top: var(--hairline) solid var(--line); }
  .item:last-child { border-bottom: var(--hairline) solid var(--line); }

  .row { position: relative; overflow: hidden; }
  /* the panel that crosses the row on hover — the buttons' object, pinned to
     the vertical by data-axis on the item */
  .tile { position: absolute; inset: 0; background: var(--glass);
          transform: translateY(-100%); will-change: transform;
          transition: transform var(--dur-base) var(--ease-panel); }

  .q { position: relative; display: flex; width: 100%; align-items: center;
       justify-content: space-between; gap: var(--s-5);
       /* flush to the rule at both ends at rest: the question on the left
          edge and its marker on the right, so both have somewhere to step
          in from */
       padding: 1.25rem 0;
       background: none; border: 0; text-align: left; cursor: pointer;
       color: var(--ink); font: inherit;
       transition: color var(--dur-fast) ease, padding var(--dur-base) var(--ease-panel); }
  .txt { font-size: var(--t-title); font-weight: var(--w-title);
         letter-spacing: var(--track-title); line-height: var(--lh-title); }
  /* the marker: dim until the row is open, and then it is simply the ink of
     whatever it is standing on — it takes the inversion with everything else */
  .q .sq { flex: none; color: var(--ink-4); transition: color var(--dur-fast) ease; }

  /* Hovering makes the same move the open row does, without the inversion:
     the question steps in from the rule and the marker steps in from the
     edge, so the row narrows around what you are about to read. Opening it
     then only has to change the colour — the geometry has already arrived. */
  @media (hover: hover) and (pointer: fine) {
    .row:hover .q { padding-left: var(--s-4); padding-right: var(--s-4); }
  }

  /* Open: the row is the ink and the page is the letters. It is the strongest
     mark this palette can make, and it costs no colour. */
  .item.open .q { background: var(--ink); color: var(--ground);
                  padding-left: var(--s-4); padding-right: var(--s-4); }
  .item.open .q .sq { color: var(--ground); }
  .item.open .tile { transform: translateY(-100%) !important; }

  /* the answer opens on its own height, written from script */
  .a { overflow: hidden; height: 0; }
  /* the answer starts where the open question's text starts: the row steps
     in by --s-4 when it opens, and the answer under it steps in the same */
  .inner { padding: var(--s-4) var(--s-4) var(--s-5); max-width: calc(52ch + var(--s-4) * 2); }
  .a p { margin: 0 0 var(--s-4); font-size: var(--t-body); line-height: var(--lh-body);
         color: var(--ink-2); }
  .a p:last-child { margin-bottom: 0; }
  /* without script every answer is simply open: the section still reads */
  .faqs:not([data-live]) .a { height: auto; }

  @media (min-width: 860px) {
    .faqs { display: grid; grid-template-columns: minmax(0, var(--col-side)) minmax(0, 1fr);
            column-gap: var(--col-gap); align-items: stretch; }
  }
  @media (max-width: 859px) {
    /* Stacked, and the founder comes after the questions: the name of the
       section leads, the questions are the section, and the way to ask more
       belongs at the end. `display: contents` lets the two halves of the
       narrow column take their own places in that order without the markup
       having to be arranged for the phone. */
    .faqs { display: flex; flex-direction: column; gap: var(--s-7); }
    .aside { display: contents; }
    .section-tag { order: 1; }
    .body { order: 2; }
    .ask { order: 3; }
    .portrait { width: 6rem; height: 6rem; }
    .txt { font-size: var(--t-lead); }
  }
</style>
