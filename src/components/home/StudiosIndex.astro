---
/** The last screen of the dark half: the studios' name, the width of the
 *  page, cut apart as it is scrolled.
 *
 *  A rule with a small line at its left — "Get to know our" — and the
 *  count at its right, and under it the one word, STUDIOS, margin to
 *  margin. The section is taller than the screen and the word holds still
 *  while it goes by: as it is scrolled it comes apart into a stack of
 *  copies, the back one still and the ones in front shrinking and dropping
 *  (scripts/ui/studiosWord.ts), so that by the foot of the section it is
 *  a fan of slices — and then the first studio, on the light, rides up
 *  over it. The page turns from dark to light by the first panel arriving.
 *
 *  Without script, or for a reader who asked for less motion, it is the
 *  word, whole, on one screen. */
import type { HomeContent } from '@lib/sanity/types';
interface Props { content: HomeContent['studios']; }
const { content } = Astro.props;
const count = String(content.items.length).padStart(2, '0');
---
{content.items.length > 0 && (
  <section class="opening" data-theme="dark" data-studios-word aria-labelledby="studios-title">
    <div class="track" data-word-track>
      <div class="pane">
        <p class="rule label"><span>Get to know our</span><span>{count}</span></p>
        <h2 id="studios-title" class="visually-hidden">{content.title}</h2>
        <!-- the word, as one SVG text so it can be measured to the page's
             width and drawn in layers; the script sizes it and does the rest -->
        <svg class="word" data-word aria-hidden="true" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="xMidYMid meet">
          <text x="0" y="0" font-size="100" dominant-baseline="hanging" data-measure>STUDIOS</text>
        </svg>
      </div>
    </div>
  </section>
)}

<style>
  .opening { position: relative; z-index: var(--z-ui); }
  /* one screen without script; with it, the screen of scroll the cut runs over */
  .track { position: relative; min-height: 100svh; }
  [data-live] .track { height: 220svh; }
  .pane { position: sticky; top: 0; min-height: 100svh; display: flex; flex-direction: column;
          justify-content: center; padding: calc(var(--nav-y) * 2 + var(--pill-h)) var(--page-x) var(--page-y);
          gap: var(--s-7); }

  /* the rule: the line at its left, the count at its right, a hairline under */
  .rule { display: flex; justify-content: space-between; margin: 0; padding-bottom: var(--s-4);
          border-bottom: var(--hairline) solid var(--line); color: var(--ink-3); }

  /* the word: the display voice, at whatever size spans the page */
  .word { display: block; width: 100%; height: auto; overflow: visible; }
  .word text { font-family: var(--font-display); font-stretch: var(--display-stretch);
               font-weight: var(--w-display); letter-spacing: var(--track-display);
               text-transform: uppercase; fill: var(--ink); }
  /* each copy stands on its own ground, which is what hides the copies
     behind it: `:global`, because the script makes them */
  .word :global(.ground) { fill: var(--ground); }

  @media (max-width: 719px) {
    [data-live] .track { height: 180svh; }
    .pane { gap: var(--s-6); }
  }
</style>
