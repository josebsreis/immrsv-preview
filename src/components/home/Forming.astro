---
/** The handover between the dark half of the homepage and the light one.
 *
 *  The page's marker, used once at the scale of the page itself: it grows
 *  into the light ground, a line lands on it, the line parts, and a figure
 *  is built between its halves — untextured, then modelled, then lit, then
 *  finished and looking back at you. Her four steps arrive where the halves
 *  of the line stood.
 *
 *  It is the argument of the practice said once, in a picture: everything
 *  here is built before it exists. The four steps she passes are how that is
 *  done — this section is the practice's method, which is why there is no
 *  separate one. The studios that follow are the proof.
 *
 *  The pane starts on the dark half's own ground, so the seam where the
 *  light half rides up over the dark one never shows — what crosses the
 *  screen is this section's own opening, not the edge of a block.
 *
 *  Without script, or for a reader who asked for less motion, the section
 *  is the line on the light at one screen tall: the argument, without the
 *  demonstration. */
interface Props {
  /** the two halves of the line, which part to make room for her */
  lead?: string;
  tail?: string;
  /** the small note at the head of the section, two lines */
  note?: string;
  steps?: { word: string; line: string }[];
}

/** One mark for each step: a thin-line solid (lib/formingShapes.ts) —
 *  two rings, a lattice, a sphere, a helix, a cube, a torus — drawn here seen
 *  straight on and turned slowly on the spot by scripts/ui/formingMarks.ts. */
import { SHAPES, pathOf } from '../../lib/formingShapes';
const {
  lead = 'Your team,',
  tail = 'extended.',
  note = 'For studios and firms at capacity.\nOne more on your team, when you need it.',
  steps = [
    { word: 'Scale without the overhead',
      line: 'IMMRSV becomes an extension of your studio when internal resources reach capacity.' },
    { word: 'One partner, more capabilities',
      line: 'From architecture and documentation to visualization, interactive experiences and digital products.' },
    { word: 'Built into your workflow',
      line: 'We adapt to your tools, standards, deadlines and processes, not the other way around.' },
    { word: 'From concept to experience',
      line: 'We turn ideas into drawings, visuals, digital environments and experiences that clients can see, understand and interact with.' },
    { word: 'Capacity when it matters',
      line: 'Bring us in for a single deadline, a specialized need or ongoing project support.' },
    { word: 'More than production',
      line: 'We bring design thinking, technology and creative problem-solving to every project we touch.' },
  ],
} = Astro.props;
---
<section class="forming" id="process" data-forming data-theme="dark" aria-label="Your team, extended">
  <!-- as tall as the scroll it wants; the pane inside it holds still -->
  <div class="track" data-forming-track>
    <div class="pane" data-forming-pane>
      <!-- the light ground: a rectangle that starts as the mark and grows -->
      <!-- a two-line note at the head of the section, in small capitals, as
           the selected work has; the light swallows it as it opens -->
      <p class="note label">{note.split('\n').map((l, i) => (<>{i > 0 && <br />}{l}</>))}</p>
      <!-- the picture of the sentence: your team, four dots; one more
           joins in the middle, and it is the one the light opens from -->
      <div class="team" data-forming-team aria-hidden="true">
        <i></i><i></i><i class="us"></i><i></i><i></i>
      </div>
      <div class="ground" data-forming-ground aria-hidden="true"></div>
      <!-- the slot she is built in: a rectangle that opens between the halves -->
      <div class="slot" data-forming-slot aria-hidden="true"><canvas></canvas></div>

      <p class="title">
        <span class="half" data-forming-half>{lead}</span>
        <span class="half" data-forming-half>{tail}</span>
      </p>

      <h2 class="visually-hidden">Your team, extended</h2>
      <ol class="steps">
        {steps.map((s, i) => (
          <li class={`beat panel ${i % 2 ? 'right' : 'left'}`} data-forming-beat>
            <div class="head">
              <h3 class="word">{s.word}</h3>
              <svg class="mark" data-forming-mark data-shape={i % SHAPES.length} viewBox="0 0 48 48" aria-hidden="true">
                <path d={pathOf(SHAPES[i % SHAPES.length], i * 1.7)} />
              </svg>
            </div>
            <p class="line">{s.line}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .forming { position: relative; }
  /* one screen until the script has it: the line, on the light, and nothing
     that needs scrolling through */
  .track { height: 100vh; position: relative; }
  /* the studios' sheet rides up over its last screen, while the last cards
     are still passing and she is still turning — no screen of her just
     standing */
  [data-live] .track { height: 690vh; }
  /* The section carries both grounds at once — it is the change from one to
     the other — so the two are named here rather than taken from the theme:
     its own `data-theme` flips partway through, for the nav's sake, and the
     planes must not flip with it. */
  .pane { position: sticky; top: 0; height: 100vh; overflow: hidden; background: #f5f5f7; }
  /* it starts on the dark half's ground, so the seam where the light half
     rides up over the dark one never shows */
  [data-live] .pane { background: #060606; }

  .ground { position: absolute; inset: 0; background: #f5f5f7; }

  /* The team: dots in a row at the middle of the screen. Yours are the
     dark ones; the light one is us, and the light grows out of it. The
     script places them — only live; without it there is nothing to tell. */
  .team { position: absolute; left: 50%; top: 50%; width: 0; height: 0; --sq: 2.5rem; }
  .forming:not([data-live]) .team { display: none; }
  .team i { position: absolute; left: calc(var(--sq) / -2); top: calc(var(--sq) / -2);
            width: var(--sq); height: var(--sq); border-radius: 50%; background: #2c2c30;
            opacity: var(--o, 0); transform: translate(var(--x, 0px), var(--y, 0px)) scale(var(--s, 1)); }
  .team i.us { background: #f5f5f7; }
  .note { position: absolute; left: 0; right: 0; top: calc(var(--page-y) + var(--s-6) + 3rem); margin: 0;
          text-align: center; line-height: 1.7; color: rgb(255 255 255 / 0.45);
          opacity: var(--nv, 0); }
  .forming:not([data-live]) .note { display: none; }
  @media (max-width: 719px) { .team { --sq: 1.75rem; } }

  /* she stands in a portrait slot at the middle of the screen. Its ground is
     the video's own, for the frame before the first still has arrived */
  .slot { position: absolute; left: 50%; top: 50%; translate: -50% -50%;
          height: min(66vh, 132vw); aspect-ratio: 9 / 16;
          background: #f5f5f7; overflow: hidden; clip-path: inset(50%); }
  .forming:not([data-live]) .slot { display: none; }
  /* The film's studio backdrop is taken out when the frames are baked —
     each frame divided by its own backdrop, so what was grey is the page's
     light exactly and she stands on the page itself, no panel. The edges
     fade too, so no hair of difference can draw a box. */
  .slot canvas { display: block;
                 -webkit-mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent),
                                     linear-gradient(to bottom, transparent, #000 3%, #000 97%, transparent);
                 -webkit-mask-composite: source-in; mask-composite: intersect;
                 mask-image: linear-gradient(to right, transparent, #000 6%, #000 94%, transparent),
                             linear-gradient(to bottom, transparent, #000 3%, #000 97%, transparent); }

  /* The argument, as two lines at the middle of the screen. They arrive
     together, part one up and one down to make the gap she is built in, and
     then stay: the claim is held above and below her for the whole passage
     rather than leaving once it has been read. Where each line stands, joined
     and parted, is measured from her and handed here as --dy. */
  .title { position: absolute; inset: 0; margin: 0; pointer-events: none;
           /* the section's title, in two halves round the figure: the display
              voice, at the size of a line rather than of a heading */
           font-family: var(--font-display); font-stretch: var(--display-stretch);
           text-transform: var(--display-case);
           font-size: var(--t-lead); font-weight: var(--w-display);
           letter-spacing: var(--track-display); color: var(--ink); }
  /* Live, the sentence is on screen before the light is: white on the dark,
     and as the light opens behind it, dark on the light — letter by letter
     where the edge crosses it, by drawing it as the difference from what is
     under it rather than in a colour of its own. */
  [data-live] .pane { isolation: isolate; }
  [data-live] .title { color: #fff; mix-blend-mode: difference; }
  .half { position: absolute; left: var(--page-x); right: var(--page-x); top: 50%;
          text-align: center; --v: 1; --dy: 0px; }
  [data-live] .half { opacity: var(--v);
                      transform: translateY(calc(-50% + var(--dy))); }

  /* The thread that carries this section down into the studios is not drawn
     here. It was — a stub under the sentence, running to the foot of the pane
     — but that stub is contiguous with the studios' own thread above their
     name, so the line above the name read longer than the one below it by
     however much of the pane was left under her, which is a different number
     on every screen. The studios own the whole line now, in two equal halves,
     and it emerges from under this pane as that pane rises. */

  /* her four steps, in the room at either side that the lines are not using */
  .steps { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; }
  .forming:not([data-live]) .steps { display: none; }
  /* Each step is a card, and it does not blink on and off: it travels a half
     circle past her — up the screen, leaning in towards her at the middle of
     its pass and back out as it leaves — so the four read as things going by
     rather than as a list being ticked. The arc is written from script as two
     offsets, because the page is one place where a sine is worth the read. */
  /* All six the same height — the tallest one's, measured by the script
     (--beat-h), and never less than a floor — with more room inside: the
     word at the top, the line at the foot, the air between them. */
  .beat { position: absolute; top: 50%; width: min(25rem, 31vw);
          display: flex; flex-direction: column; box-sizing: border-box;
          padding: var(--s-5) var(--s-6); min-height: max(var(--beat-h, 0px), 12.5rem);
          color: var(--ink); pointer-events: none;
          opacity: var(--v, 0); --v: 0; --ax: 0px; --ay: 0px;
          transform: translate(var(--ax), calc(-50% + var(--ay))); }
  .beat.left { left: var(--page-x); }
  .beat.right { right: var(--page-x); }
  /* the word, and its mark drawn large and thin beside it */
  .head { display: flex; align-items: center; justify-content: space-between;
          gap: var(--s-5); margin-bottom: var(--s-6); }
  .word { margin: 0; font-size: var(--t-title); font-weight: var(--w-display);
          letter-spacing: var(--track-display); line-height: var(--lh-title); }
  /* The mark: a cluster of particles. The script places each one every
     frame — the solid turning, and each particle arriving from a little way
     off, small, one after another, as the card comes in. Without script
     every particle sits at its seat as seen straight on. */
  /* It is taller than the word beside it, and must not set the row's height:
     with the row as tall as the mark the word floated in the middle of it and
     the card read as having twice the padding above as at its sides. The
     margins give back what it stands proud of the word by, so the row is the
     word's height and the mark overhangs into the card's own padding. */
  /* the mark: a hairline drawing, the ink's own grey, turning slowly */
  .mark { flex: none; width: 3rem; height: 3rem; margin-block: -0.8rem; overflow: visible; }
  .mark path { fill: none; stroke: var(--ink-3); stroke-width: 1; vector-effect: non-scaling-stroke;
               stroke-linejoin: round; stroke-linecap: round; }

  .line { margin: auto 0 0; font-size: var(--t-small); color: var(--ink-2); line-height: var(--lh-body); }

  /* Narrow: she takes the width and stands in the middle of the screen, the
     line reads as two halves above and below her, and her steps do not pass
     beside her — there is no beside on a phone — but over her: each comes
     up from the foot of the screen, crosses her and leaves at the head, the
     way a list scrolls over a picture that holds still. */
  @media (max-width: 719px) {
    [data-live] .track { height: 630vh; }
    .slot { height: min(56vh, 128vw); }
    .title { font-size: var(--t-small); }
    /* from the middle, and the script carries it the height of the screen */
    .beat { top: 50%; width: calc(100% - var(--page-x) * 2);
            left: var(--page-x); right: auto;
            transform: translateY(calc(-50% + var(--ay))); }

  }
</style>
