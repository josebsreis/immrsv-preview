---
/** The handover between the dark half of the homepage and the light one.
 *
 *  The page's marker, used once at the scale of the page itself: it grows
 *  into the light ground, a line lands on it, the line parts, and a figure
 *  is built between its halves — untextured, then modelled, then lit, then
 *  finished and looking back at you. Her four steps arrive where the halves
 *  of the line stood.
 *
 *  It is the argument of the practice said once, in a picture: everything
 *  here is built before it exists. The studios that follow are the proof.
 *
 *  The pane starts on the dark half's own ground, so the seam where the
 *  light half rides up over the dark one never shows — what crosses the
 *  screen is this section's own opening, not the edge of a block.
 *
 *  Without script, or for a reader who asked for less motion, the section
 *  is the line on the light at one screen tall: the argument, without the
 *  demonstration. */
interface Props {
  /** the two halves of the line, which part to make room for her */
  lead?: string;
  tail?: string;
  steps?: { word: string; line: string }[];
}
const {
  lead = 'Before it exists,',
  tail = "we've already built it.",
  steps = [
    { word: 'Draw', line: 'The building, at real scale, from the first sketch.' },
    { word: 'Model', line: 'Every surface built, not painted on.' },
    { word: 'Light', line: 'Real optics, real materials, no flattery.' },
    { word: 'Build', line: 'Shipped, and kept working.' },
  ],
} = Astro.props;
---
<section class="forming" data-forming data-theme="dark" aria-label="How we work">
  <!-- as tall as the scroll it wants; the pane inside it holds still -->
  <div class="track" data-forming-track>
    <div class="pane">
      <!-- the light ground: a rectangle that starts as the mark and grows -->
      <div class="ground" data-forming-ground aria-hidden="true"></div>
      <!-- the slot she is built in: a rectangle that opens between the halves -->
      <div class="slot" data-forming-slot aria-hidden="true"><canvas></canvas></div>

      <p class="title">
        <span class="half" data-forming-half>{lead}</span>
        <span class="half" data-forming-half>{tail}</span>
      </p>

      <ol class="steps">
        {steps.map((s, i) => (
          <li class={`beat ${i % 2 ? 'right' : 'left'}`} data-forming-beat>
            <span class="label n">{String(i + 1).padStart(2, '0')}</span>
            <span class="word">{s.word}</span>
            <span class="line">{s.line}</span>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .forming { position: relative; }
  /* one screen until the script has it: the line, on the light, and nothing
     that needs scrolling through */
  .track { height: 100vh; position: relative; }
  [data-live] .track { height: 440vh; }
  /* The section carries both grounds at once — it is the change from one to
     the other — so the two are named here rather than taken from the theme:
     its own `data-theme` flips partway through, for the nav's sake, and the
     planes must not flip with it. */
  .pane { position: sticky; top: 0; height: 100vh; overflow: hidden; background: #f5f5f7; }
  /* it starts on the dark half's ground, so the seam where the light half
     rides up over the dark one never shows */
  [data-live] .pane { background: #060606; }

  .ground { position: absolute; inset: 0; background: #f5f5f7; }

  /* she stands in a portrait slot at the middle of the screen. Its ground is
     the video's own, for the frame before the first still has arrived */
  .slot { position: absolute; left: 50%; top: 50%; translate: -50% -50%;
          height: min(72vh, 132vw); aspect-ratio: 2 / 3;
          background: #ebeaec; overflow: hidden; clip-path: inset(50%); }
  .forming:not([data-live]) .slot { display: none; }
  /* the render's ground is a shade under the site's light one; lifted here so
     the two read as one plane */
  .slot canvas { display: block; filter: brightness(1.045); }

  /* The line, level with her middle, so the slot opens between its halves.
     They are laid out where they end up — out at the page's margins — and
     the distance back to the middle is measured from there and handed to
     CSS as --dx, so the join is exact at any width. */
  .title { position: absolute; inset: 0; margin: 0; pointer-events: none;
           font-size: var(--t-lead); font-weight: 500; letter-spacing: -0.01em;
           color: var(--ink); }
  .half { position: absolute; top: 50%; translate: 0 -50%; white-space: nowrap;
          --v: 1; --x: 1; --dx: 0px; }
  .half:first-child { right: 50%; text-align: right; }
  .half:last-child { left: 50%; }
  [data-live] .half { opacity: var(--v);
                      transform: translateX(calc(var(--dx) * (1 - var(--x)))); }

  /* her four steps, where the halves of the line stood */
  .steps { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; }
  .forming:not([data-live]) .steps { display: none; }
  .beat { position: absolute; top: 50%; max-width: 17rem;
          display: flex; flex-direction: column; gap: 0.5rem;
          color: var(--ink); pointer-events: none;
          opacity: var(--v, 0); --v: 0;
          transform: translateY(calc(-50% + (1 - var(--v)) * 14px)); }
  .beat.left { left: var(--page-x); }
  .beat.right { right: var(--page-x); text-align: right; align-items: flex-end; }
  .n { color: var(--ink-3); }
  .word { font-size: var(--t-display); font-weight: 500; letter-spacing: -0.03em; line-height: 0.95; }
  .line { font-size: var(--t-small); color: var(--ink-2); line-height: 1.5; }

  /* Narrow: she takes the width, the line reads as two stacked halves above
     her, and her steps sit at the foot rather than beside her — there is no
     beside on a phone. */
  @media (max-width: 719px) {
    [data-live] .track { height: 380vh; }
    .slot { height: min(56vh, 128vw); }
    /* the line is two lines, above her, and the halves never part: there is
       no beside on a phone */
    .title { inset: 12vh var(--page-x) auto; text-align: center;
             font-size: var(--t-small); }
    .half, .half:first-child, .half:last-child {
      position: static; translate: none; white-space: normal;
      display: block; text-align: center; left: auto; right: auto; }
    [data-live] .half { transform: none; }
    .beat { top: auto; bottom: var(--page-y); max-width: none; width: calc(100% - var(--page-x) * 2);
            left: var(--page-x) !important; right: auto !important;
            text-align: left !important; align-items: flex-start !important;
            transform: translateY(calc((1 - var(--v)) * 10px)); }
    .word { font-size: 2rem; }
  }
</style>
