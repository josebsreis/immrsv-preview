---
/** The handover between the dark half of the homepage and the light one.
 *
 *  The page's marker, used once at the scale of the page itself: it grows
 *  into the light ground, a line lands on it, the line parts, and a figure
 *  is built between its halves — untextured, then modelled, then lit, then
 *  finished and looking back at you. Her four steps arrive where the halves
 *  of the line stood.
 *
 *  It is the argument of the practice said once, in a picture: everything
 *  here is built before it exists. The four steps she passes are how that is
 *  done — this section is the practice's method, which is why there is no
 *  separate one. The studios that follow are the proof.
 *
 *  The pane starts on the dark half's own ground, so the seam where the
 *  light half rides up over the dark one never shows — what crosses the
 *  screen is this section's own opening, not the edge of a block.
 *
 *  Without script, or for a reader who asked for less motion, the section
 *  is the line on the light at one screen tall: the argument, without the
 *  demonstration. */
interface Props {
  /** the two halves of the line, which part to make room for her */
  lead?: string;
  tail?: string;
  steps?: { word: string; line: string }[];
}

/** One mark for each step, drawn in the page's own language: hairline,
 *  square-cornered, geometric. They are the only ornament on the site and
 *  they earn their place by saying what the step is before the word does. */
const marks = [
  /* a plan, with the dimension line above it */
  '<rect x="3.5" y="9.5" width="17" height="11"/><path d="M3.5 5.5h17M3.5 4v3M20.5 4v3"/>',
  /* built: a wireframe solid */
  '<path d="M12 2.5l8.5 4.75v9.5L12 21.5l-8.5-4.75v-9.5L12 2.5z"/><path d="M12 12l8.5-4.75M12 12L3.5 7.25M12 12v9.5"/>',
  /* the sun, the thing it falls on, and the shadow that proves it */
  '<circle cx="18" cy="6" r="2.6"/><path d="M15.6 8.4 12 12"/><rect x="4.5" y="11.5" width="7.5" height="9"/><path d="M12 20.5h7.5"/>',
  /* delivered, and still running */
  '<rect x="3.5" y="5" width="17" height="14"/><path d="M3.5 9.5h17M6.5 7.2h1.2M9.5 7.2h1.2"/>',
];
const {
  lead = 'Before it exists,',
  tail = "we've already built it.",
  steps = [
    { word: 'Understand',
      line: 'What the project has to do, who moves through it and where the real constraint sits — settled before anything is drawn, while the decisions are still cheap to change.' },
    { word: 'Build',
      line: 'One team draws it, models it and builds it. Nothing is handed over halfway, so the drawing, the render and the interface stay the same idea throughout.' },
    { word: 'Show',
      line: 'The image is made from the model rather than around it. Real optics, real materials, and no flattery the thing cannot deliver.' },
    { word: 'Refine',
      line: 'We stay with it after delivery. What gets used tells us more than what got approved, and the work is corrected against that.' },
  ],
} = Astro.props;
---
<section class="forming" data-forming data-theme="dark" aria-label="How we work">
  <!-- as tall as the scroll it wants; the pane inside it holds still -->
  <div class="track" data-forming-track>
    <div class="pane">
      <!-- the light ground: a rectangle that starts as the mark and grows -->
      <div class="ground" data-forming-ground aria-hidden="true"></div>
      <!-- the slot she is built in: a rectangle that opens between the halves -->
      <div class="slot" data-forming-slot aria-hidden="true"><canvas></canvas></div>

      <!-- the thread she is left standing on: it starts under the sentence and
           runs to the foot of the pane, where the studios pick it up -->
      <span class="thread" data-forming-thread aria-hidden="true"></span>

      <p class="title">
        <span class="half" data-forming-half>{lead}</span>
        <span class="half" data-forming-half>{tail}</span>
      </p>

      <ol class="steps">
        {steps.map((s, i) => (
          <li class={`beat panel ${i % 2 ? 'right' : 'left'}`} data-forming-beat>
            <div class="head">
              <h3 class="word">{s.word}</h3>
              <svg class="mark" viewBox="0 0 24 24" aria-hidden="true" set:html={marks[i % marks.length]} />
            </div>
            <p class="line">{s.line}</p>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<style>
  .forming { position: relative; }
  /* one screen until the script has it: the line, on the light, and nothing
     that needs scrolling through */
  .track { height: 100vh; position: relative; }
  [data-live] .track { height: 440vh; }
  /* The section carries both grounds at once — it is the change from one to
     the other — so the two are named here rather than taken from the theme:
     its own `data-theme` flips partway through, for the nav's sake, and the
     planes must not flip with it. */
  .pane { position: sticky; top: 0; height: 100vh; overflow: hidden; background: #f5f5f7; }
  /* it starts on the dark half's ground, so the seam where the light half
     rides up over the dark one never shows */
  [data-live] .pane { background: #060606; }

  .ground { position: absolute; inset: 0; background: #f5f5f7; }

  /* she stands in a portrait slot at the middle of the screen. Its ground is
     the video's own, for the frame before the first still has arrived */
  .slot { position: absolute; left: 50%; top: 50%; translate: -50% -50%;
          height: min(66vh, 132vw); aspect-ratio: 2 / 3;
          background: #ebeaec; overflow: hidden; clip-path: inset(50%); }
  .forming:not([data-live]) .slot { display: none; }
  /* the render's ground is a shade under the site's light one; lifted here so
     the two read as one plane */
  .slot canvas { display: block; filter: brightness(1.045); }

  /* The argument, as two lines at the middle of the screen. They arrive
     together, part one up and one down to make the gap she is built in, and
     then stay: the claim is held above and below her for the whole passage
     rather than leaving once it has been read. Where each line stands, joined
     and parted, is measured from her and handed here as --dy. */
  .title { position: absolute; inset: 0; margin: 0; pointer-events: none;
           font-size: var(--t-lead); font-weight: var(--w-ui);
           letter-spacing: var(--track-lead); color: var(--ink); }
  .half { position: absolute; left: var(--page-x); right: var(--page-x); top: 50%;
          text-align: center; --v: 1; --dy: 0px; }
  [data-live] .half { opacity: var(--v);
                      transform: translateY(calc(-50% + var(--dy))); }

  /* The line she is left standing on. It is drawn only once she is finished,
     runs from under the sentence to the foot of the pane, and is continued by
     the studios section directly below — one thread from her to the first
     studio, so the page reads as carrying on rather than starting again. */
  .thread { position: absolute; left: 50%; width: var(--hairline);
            background: var(--line); transform-origin: top;
            transform: scaleX(1) scaleY(var(--v, 0)); opacity: var(--v, 0); }
  .forming:not([data-live]) .thread { display: none; }

  /* her four steps, in the room at either side that the lines are not using */
  .steps { position: absolute; inset: 0; margin: 0; padding: 0; list-style: none; }
  .forming:not([data-live]) .steps { display: none; }
  /* Each step is a card, and it does not blink on and off: it travels a half
     circle past her — up the screen, leaning in towards her at the middle of
     its pass and back out as it leaves — so the four read as things going by
     rather than as a list being ticked. The arc is written from script as two
     offsets, because the page is one place where a sine is worth the read. */
  .beat { position: absolute; top: 50%; width: min(22rem, 31vw);
          color: var(--ink); pointer-events: none;
          opacity: var(--v, 0); --v: 0; --ax: 0px; --ay: 0px;
          transform: translate(var(--ax), calc(-50% + var(--ay))); }
  .beat.left { left: var(--page-x); }
  .beat.right { right: var(--page-x); }
  /* the word, and its mark drawn large and thin beside it */
  .head { display: flex; align-items: center; justify-content: space-between;
          gap: var(--s-5); margin-bottom: 0.7rem; }
  .word { margin: 0; font-size: var(--t-title); font-weight: var(--w-title);
          letter-spacing: var(--track-title); line-height: var(--lh-title); }
  .mark { flex: none; width: 2.5rem; height: 2.5rem;
          fill: none; stroke: var(--ink); stroke-width: 0.7; }
  .line { margin: 0; font-size: var(--t-small); color: var(--ink-2); line-height: var(--lh-body); }

  /* Narrow: she takes the width, the line reads as two stacked halves above
     her, and her steps sit at the foot rather than beside her — there is no
     beside on a phone. */
  @media (max-width: 719px) {
    [data-live] .track { height: 380vh; }
    /* she sits a little above centre, to leave the foot of the screen to the
       card that is passing */
    .slot { height: min(56vh, 128vw); top: 42%; }
    .title { font-size: var(--t-small); }
    .beat { top: auto; bottom: var(--page-y); width: calc(100% - var(--page-x) * 2);
            left: var(--page-x); right: auto;
            transform: translateY(var(--ay)); }

  }
</style>
