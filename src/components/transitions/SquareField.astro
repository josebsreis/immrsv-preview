---
/** The handover between the dark half of the homepage and the light one.
 *
 *  The page's marker, used once at the scale of the page itself. One square
 *  appears where the hero's mark stood and grows; its neighbours arrive in
 *  order of how far they are from it, so the field spreads as a front rather
 *  than a wipe; and by the time the front reaches the corners every square has
 *  grown into its own cell, which makes them a single plane — and that plane
 *  is the light section, already begun. Nothing is overlaid: this band sits in
 *  the flow at the head of the section, and what fills it is its ground.
 *
 *  One value drives it. The container carries `--p`, the scroll's progress
 *  through the handover, written once a frame by scripts/ui/scrollChoreography;
 *  every cell carries `--t`, the moment it is due. Its opacity and its scale
 *  are `clamp()`ed from the difference, so no square is touched from script.
 *
 *  The grid is built on the client because it has to answer to the width it
 *  is given — square cells at any viewport, and no count baked into the HTML.
 *  Until it is (no script, or a reader who asked for less motion) the band is
 *  simply filled: the section arrives without ceremony, which is the point of
 *  the fallback. */
interface Props { height?: string; theme?: 'dark' | 'light'; }
const { height = '52vh', theme = 'light' } = Astro.props;
---
<div class="field" data-square-field data-theme={theme} style={`--band: ${height}`} aria-hidden="true"></div>

<script>
  /* target width of a cell, in px — the grain of the field. The count falls
     out of the width, and is capped so a very wide screen does not put two
     thousand elements on the page for the same effect. */
  const CELL = 52;
  const COLS = [8, 34] as const;
  const ROWS = [4, 12] as const;
  /* how much of the handover is spent arriving; the rest is the plane holding
     while the section itself rides up */
  const SPREAD = 0.42;
  const JITTER = 0.07;      // the front is a front, not a compass circle

  const clamp = (v: number, lo: number, hi: number) => Math.max(lo, Math.min(hi, v));

  let field: HTMLElement | null = null;
  let last = '';

  const build = () => {
    if (!field) return;
    const w = field.clientWidth, h = field.clientHeight;
    if (!w || !h) return;
    const key = `${w}x${h}`;
    if (key === last) return;
    last = key;

    const cols = clamp(Math.round(w / CELL), COLS[0], COLS[1]);
    const cw = w / cols;
    const rows = clamp(Math.round(h / cw), ROWS[0], ROWS[1]);
    const ch = h / rows;

    // where the hero's mark stood: the middle of the band, so the field opens
    // outward and meets the solid section along its whole foot at once
    const fx = w / 2, fy = h / 2;
    const far = Math.hypot(fx, fy);

    let html = '';
    for (let r = 0; r < rows; r++) {
      for (let c = 0; c < cols; c++) {
        const d = Math.hypot((c + 0.5) * cw - fx, (r + 0.5) * ch - fy);
        const t = (d / far) * SPREAD + Math.random() * JITTER;
        html += `<i style="--t:${t.toFixed(3)}"></i>`;
      }
    }
    field.style.setProperty('--cols', String(cols));
    field.style.setProperty('--rows', String(rows));
    /* the smallest a square gets is the site's own marker, whatever the cell
       around it turned out to be */
    field.style.setProperty('--min', (5 / cw).toFixed(3));
    field.innerHTML = html;
    field.dataset.live = '';
  };

  let pending = 0;
  const onResize = () => {
    cancelAnimationFrame(pending);
    pending = requestAnimationFrame(build);
  };

  const start = () => {
    field = document.querySelector<HTMLElement>('[data-square-field]');
    if (!field) return;
    if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;
    last = '';
    build();
    addEventListener('resize', onResize);
  };

  const stop = () => {
    removeEventListener('resize', onResize);
    cancelAnimationFrame(pending);
    field = null;
  };

  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', stop);
</script>

<style>
  /* Filled, until the grid that replaces the fill has been built. The band
     takes the ground of the section it is announcing, and `currentColor` is
     what the squares are drawn in too, so the two can never disagree. */
  .field { position: relative; z-index: var(--z-ui);
           width: 100%; height: var(--band); overflow: hidden;
           color: var(--ground); background: currentColor;
           pointer-events: none; --p: 0; }

  .field[data-live] { background: none; display: grid;
                      grid-template-columns: repeat(var(--cols), 1fr);
                      grid-template-rows: repeat(var(--rows), 1fr); }

  /* The whole animation. `--p` comes down from the container and `--t` is the
     cell's own due moment; the difference, opened up, is both its presence and
     its size. It grows a little past its cell — the squares are all one colour
     and the overlap is what keeps a hairline of the dark half from showing
     between two of them once the plane has closed. */
  /* `:global`, and it has to be: the cells are built on the client, so they
     never carry the scope attribute the compiler hangs on markup it can see.
     The `.field` in front of it is scoped, which keeps the rule to this
     component.

     Presence arrives well ahead of size — that is the difference between a
     square appearing and then growing, and a grey smudge resolving. At the
     rates below a cell is solid by the time it is a fifth of the way up,
     so what the eye follows is the site's own 5px marker enlarging. */
  .field :global(i) { display: block; background: currentColor;
             opacity: clamp(0, (var(--p) - var(--t)) * 10, 1);
             scale: clamp(var(--min, 0.12), (var(--p) - var(--t)) * 4.5, 1.04); }
</style>
