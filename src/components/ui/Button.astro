---
/** The site's button: a glass slab with the square on the left. On hover a
 *  panel slides in from the edge the cursor crossed, the square travels to the
 *  right end and the letters slip left one after another. `data-split` marks
 *  the label for the character split; `data-tap` gives it the hover sound. */
interface Props { href: string; label: string; class?: string;
  /** the whole width of its column — a slab rather than a pill */
  wide?: boolean; }
const { href, label, class: cls, wide = false } = Astro.props;
---
<a class:list={['btn', 'glass', cls, { wide }]} href={href} data-tap data-dhover-item data-axis="x">
  <span class="tile" data-dhover-tile aria-hidden="true"></span>
  <i class="sq" aria-hidden="true"></i>
  <b data-split>{label}</b>
</a>

<style>
  .btn {
    --pl: 2.125rem; --pr: 1.625rem; --gap: 1rem;
    position: relative; overflow: hidden;
    display: inline-flex; align-items: center;
    height: 2.375rem; padding: 0 var(--pr) 0 var(--pl);
    font-size: var(--t-caption); letter-spacing: var(--track-caps); text-transform: uppercase;
    color: var(--ink);
    transition: scale 0.15s cubic-bezier(0.4, 0, 0.2, 1);
  }
  /* the panel replaces the plain background change; a slab this short only
     reads the horizontal edges, so the item is pinned to the x axis */
  .btn:hover { background-image: linear-gradient(var(--glass), var(--glass)); }
  .tile { position: absolute; inset: 0; background: var(--glass-hover);
          transform: translateX(-100%); will-change: transform;
          transition: transform var(--dur-base) var(--ease-panel); }
  .btn:active { scale: 0.97; }
  /* A slab: the same object, the width of its column, a little taller. Its
     dot sits at the right end from the start and nothing on it travels on
     hover — across a slab this wide the dot's journey and the letters
     chasing it were a lot of movement for one hover — so only the panel
     sweeping in answers the pointer. */
  .btn.wide { display: flex; width: 100%; height: 3rem; --pl: 1.625rem; --pr: 2.125rem; }
  .btn.wide .sq { left: auto; right: var(--gap); }
  .btn b { position: relative; font-weight: var(--w-ui); white-space: nowrap; }
  .btn .sq { position: absolute; left: var(--gap); top: 50%; margin-top: calc(var(--square) / -2); transition: left 0.66s 0.05s var(--ease-snap); }
  .btn :global(.ch) { display: inline-block; white-space: pre; transition: translate 0.66s calc(var(--i) * 0.016s + 0.05s) var(--ease-snap); }
  @media (hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference) {
    .btn:not(.wide):hover .sq { left: calc(100% - var(--gap) - var(--square)); }
    .btn:not(.wide):hover :global(.ch) { translate: calc(var(--gap) - var(--pl)) 0; }
  }
  @media (prefers-reduced-motion: reduce) { .tile { transition: none; } }
</style>
