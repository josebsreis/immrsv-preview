---
/** Between pages: the page fades away under the nav, which stays; the mark
 *  assembles in the middle of the empty ground — its three faces, the three
 *  studios, coming together — and as it comes apart again the next page
 *  fades in round it. It persists across pages so it is the same layer
 *  going and coming (scripts/ui/curtain.ts). */
import { SYMBOL } from '../../lib/lettermark';
---
<div class="curtain" data-curtain transition:persist="curtain" aria-hidden="true">
  <svg class="mark" viewBox={SYMBOL.viewBox}>
    {SYMBOL.paths.map((d, k) => <path d={d} data-face={k} />)}
  </svg>
</div>

<script>
  import { createCurtain } from '../../scripts/ui/curtain';
  createCurtain();
</script>

<style>
  /* over the page, under the nav — the nav stays through the change — and
     not there at all until it is used */
  .curtain { position: fixed; inset: 0; z-index: var(--z-ui); pointer-events: none;
             display: grid; place-items: center; opacity: 0; visibility: hidden;
             background: var(--c-ground, #060606); transition: background-color 0.3s ease; }
  .curtain.on { visibility: visible; pointer-events: auto; }
  .mark { width: clamp(3rem, 5.5vw, 4.5rem); height: auto; overflow: visible; }
  .mark path { fill: var(--c-ink, #f3f3f4); opacity: 0; transition: fill 0.3s ease; }
</style>
