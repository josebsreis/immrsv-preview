---
/** The wordmark's letters alone — IMMRSV without the symbol — inline so it
 *  takes `currentColor` and can be scaled to any width. */
import { LETTERMARK } from '@lib/lettermark';
interface Props { class?: string; }
const { class: cls } = Astro.props;
---
<svg class={cls} viewBox={LETTERMARK.viewBox} fill="currentColor" role="img" aria-label="IMMRSV">
  {LETTERMARK.paths.map((d) => <path d={d} />)}
</svg>
