---
/** The word beside the pointer (scripts/ui/cursor.ts): a pill that follows
 *  the mouse over anything marked `data-cursor-hover` and says what it does.
 *  White, and the same white everywhere — a plain object over a photograph
 *  and over either page ground alike, with the light ground's ink on it.
 *  The drag kind carries a white disc either side, outside the pill: the
 *  two directions it can be pulled. */
---
<div class="cursor" data-cursor data-panel="light" aria-hidden="true">
  <!-- the drag kind's two discs stand outside the pill, one each side: the
       two ways it can be pulled, and they lean out a little, by turns -->
  <span class="row">
    <i class="disc l"></i>
    <span class="bubble"><span class="label" data-cursor-text-target></span></span>
    <i class="disc r"></i>
  </span>
</div>

<style>
  /* only a mouse has a hover; the pill is not drawn for anything else */
  .cursor { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .cursor { display: block; position: fixed; left: 0; top: 0; z-index: var(--z-cursor);
              pointer-events: none; will-change: translate; }
    .row { display: flex; align-items: center; gap: var(--s-2);
           opacity: 0; scale: 0.9; transform-origin: left top;
           transition: opacity var(--dur-fast) var(--ease-panel), scale var(--dur-fast) var(--ease-panel); }
    [data-cursor="on"] .row { opacity: 1; scale: 1; }
    .bubble { display: inline-flex; align-items: center;
              height: var(--pill-h); padding: 0 var(--s-4);
              background: var(--surface); color: var(--ink); border-radius: var(--radius);
              white-space: nowrap; }
    /* the drag kind's discs: white, outside the pill, and each leans out its
       own way and back, one after the other */
    .disc { display: none; width: 0.625rem; height: 0.625rem; border-radius: 50%;
            background: var(--surface);
            transition: translate var(--dur-fast) var(--ease-panel), scale var(--dur-fast) var(--ease-panel); }
    [data-cursor-kind="drag"] .disc { display: block; animation: lean 1.6s ease-in-out infinite; }
    .disc.l { --out: -3px; }
    .disc.r { --out: 3px; animation-delay: -0.8s; }
    @keyframes lean {
      0%, 100% { translate: 0 0; }
      50% { translate: var(--out) 0; }
    }
    /* Pressed: the whole thing draws in a touch, the discs spring out to
       either side — the lean stops, they are held out — and once the hand
       has set off, the disc on that side grows and the other shrinks, so
       the pill points where the cards are going. */
    [data-press] .row { scale: 0.86; }
    [data-press] .disc { animation: none; }
    [data-press] .disc.l { translate: -10px 0; }
    [data-press] .disc.r { translate: 10px 0; }
    [data-press][data-dir="l"] .disc.l, [data-press][data-dir="r"] .disc.r { scale: 1.5; }
    [data-press][data-dir="l"] .disc.r, [data-press][data-dir="r"] .disc.l { scale: 0.6; }
  }
  @media (prefers-reduced-motion: reduce) { .row, .disc { transition: none; } .disc { animation: none; } }
</style>
