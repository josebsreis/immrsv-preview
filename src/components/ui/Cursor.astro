---
/** The word beside the pointer (scripts/ui/cursor.ts): a pill that follows
 *  the mouse over anything marked `data-cursor-hover` and says what it does.
 *  Inverted — the ink as ground — so it reads over a photograph and over
 *  either page ground alike. The drag kind carries a dot either side: the
 *  two directions it can be pulled. */
---
<div class="cursor" data-cursor aria-hidden="true">
  <span class="bubble">
    <i class="sq side l"></i>
    <span class="label" data-cursor-text-target></span>
    <i class="sq side r"></i>
  </span>
</div>

<style>
  /* only a mouse has a hover; the pill is not drawn for anything else */
  .cursor { display: none; }
  @media (hover: hover) and (pointer: fine) {
    .cursor { display: block; position: fixed; left: 0; top: 0; z-index: var(--z-cursor);
              pointer-events: none; will-change: translate; }
    .bubble { display: inline-flex; align-items: center; gap: var(--s-2);
              height: var(--pill-h); padding: 0 var(--s-4);
              background: var(--ink); color: var(--ground); border-radius: var(--radius);
              white-space: nowrap;
              opacity: 0; scale: 0.9; transform-origin: left top;
              transition: opacity var(--dur-fast) var(--ease-panel), scale var(--dur-fast) var(--ease-panel); }
    [data-cursor="on"] .bubble { opacity: 1; scale: 1; }
    /* the drag kind: a dot either side, for the two ways it goes */
    .side { display: none; color: var(--ground); }
    [data-cursor-kind="drag"] .side { display: inline-block; }
    [data-cursor-kind="drag"] .bubble { padding: 0 var(--s-3); }
  }
  @media (prefers-reduced-motion: reduce) { .bubble { transition: none; } }
</style>
