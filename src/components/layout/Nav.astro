---
import Wordmark from '@components/ui/Wordmark.astro';
interface Props { items: readonly { label: string; href: string }[]; }
const { items } = Astro.props;
---
<!--
  The bar that never leaves. Three things, and it needs all three:
  `persist` carries this exact node into the next page instead of rebuilding
  it; `name` lifts it out of the page's snapshot, which would otherwise
  cross-fade it along with everything else it is sitting on top of; and
  `animate="none"` means its own snapshot is not animated either. What is
  left is a bar that holds still while the pages change under it, and only
  follows the ground's colour. All three have to sit on the element — on the
  <Nav /> tag the directives are not forwarded to it.
-->
<header class="nav arrives" data-theme-follows style="--arrive-delay: .5s"
        transition:persist="nav" transition:name="nav" transition:animate="none">
  <a class="home" href="/" aria-label="IMMRSV — home" data-tap><Wordmark /></a>
  <nav class="menu" aria-label="Primary">
    {items.map((it) => (
      <a class="item label" href={it.href} data-tap data-dhover-item data-axis="x">
        <span class="tile" data-dhover-tile aria-hidden="true"></span>
        <span class="txt">{it.label}</span>
      </a>
    ))}
  </nav>
</header>

<style>
  .nav {
    position: fixed; top: 0; left: 0; right: 0; z-index: var(--z-nav);
    display: flex; justify-content: space-between; align-items: center;
    padding: var(--nav-y) var(--page-x);
    color: var(--ink);
    transition: color var(--dur-base) ease;
    pointer-events: none;
  }
  .home { pointer-events: auto; display: block; }
  /* the child svg is sized from here — a class passed across component scopes would not be */
  .home :global(svg) { height: 2.125rem; width: auto; color: var(--ink); transition: color var(--dur-base) ease; }
  .menu { display: flex; gap: 2px; pointer-events: auto; }
  /* the pills answer the way the buttons do: a panel from the edge crossed */
  /* Solid, not glass: the page's own surface — white on the light ground, the
     dark panel colour on the dark one — on the UI radius. Glass earned its
     keep when the nav crossed photographs; the pills now cross plain grounds
     nearly all the way down, and a solid object is easier to read there. */
  .item { position: relative; overflow: hidden; display: flex; align-items: center; height: var(--pill-h); padding: 0 var(--s-4);
          background-color: var(--surface); border-radius: var(--radius);
          color: var(--ink); transition: color var(--dur-base) ease, background-color var(--dur-base) ease; }
  /* the tint only — the shorthand would take the surface under it with it */
  @media (hover: hover) and (pointer: fine) { .item:hover { background-image: linear-gradient(var(--glass), var(--glass)); } }
  .tile { position: absolute; inset: 0; background: var(--glass-hover);
          transform: translateX(-100%); will-change: transform;
          transition: transform var(--dur-base) var(--ease-panel); }
  .txt { position: relative; }
  @media (prefers-reduced-motion: reduce) { .tile { transition: none; } }
  @media (max-width: 719px) {
    .nav { padding: 1.125rem var(--page-x); }
    .home :global(svg) { height: 1.6875rem; }
    .menu { display: none; }
  }
</style>
