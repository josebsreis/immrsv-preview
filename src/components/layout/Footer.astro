---
/** The foot of every page: a black band, the invitation, the ways in, and
 *  the name drawn once at full width.
 *
 *  PLACEHOLDER. The shape is right, but the address, the number and the
 *  accounts are stand-ins until the client sends the real ones — everything
 *  marked below is meant to be replaced, not kept. */
import Button from '@components/ui/Button.astro';
import { site } from '@lib/site';

const year = new Date().getFullYear();

/* placeholder — the practice's own accounts and details */
const social = [
  { label: 'LinkedIn', href: '#' },
  { label: 'Instagram', href: '#' },
  { label: 'Behance', href: '#' },
  { label: 'Dribbble', href: '#' },
];
const enquiry = [
  { k: 'E', label: 'hello@immrsv.studio', href: 'mailto:hello@immrsv.studio' },
  { k: 'P', label: '747.302.6868', href: 'tel:+17473026868' },
];
const acts = [
  { label: 'Discuss your project', href: 'mailto:hello@immrsv.studio' },
  { label: 'Book a 30-minute call', href: 'mailto:hello@immrsv.studio' },
];

/** what a site has to say about itself, at its foot */
const legal = [
  { label: 'Privacy policy', href: '/privacy' },
  { label: 'Terms of use', href: '/terms' },
];
---
<footer class="footer" id="contact" data-theme="dark">
  <div class="top">
    <span class="label">Start here.</span>
    <span class="label when" data-clock aria-hidden="true"></span>
  </div>

  <div class="invite">
    <h2 class="ask">Let’s create<br />something IMMRSV.</h2>
    <div class="acts">
      {acts.map((a) => <Button href={a.href} label={a.label} />)}
    </div>
  </div>

  <div class="cols">
    <div class="col">
      <span class="label head">Business enquiry</span>
      <ul>
        {enquiry.map((e) => (
          <li><span class="k">{e.k}.</span><a href={e.href} data-tap>{e.label}</a></li>
        ))}
      </ul>
    </div>
    <div class="col">
      <span class="label head">Social</span>
      <ul class="pairs">
        {social.map((sx) => <li><a href={sx.href} data-tap>{sx.label}</a></li>)}
      </ul>
    </div>
  </div>

  <!-- the small print, over the name: what the site owes its readers on the
       left, whose it is on the right -->
  <div class="legal">
    <ul>
      {legal.map((l) => <li><a class="label" href={l.href} data-tap>{l.label}</a></li>)}
    </ul>
    <span class="label">© {year} {site.name}. All rights reserved.</span>
  </div>

  <!-- the name, the last thing on the page and as wide as the page's margins
       allow. A plain drawing — the letters of the wordmark, without the mark
       — to be replaced by the final artwork. -->
  <div class="mark">
    <svg viewBox="275 78.35 695.44 85.45" fill="currentColor" role="img" aria-label={site.name}>
      <path d="M296.23 78.36H275V163.8H296.23V78.36Z"/>
      <path d="M373.91 139.3L327.02 78.36H307.11V163.8H328.34V116.65L364.61 163.8H383.21L419.47 116.65V163.8H440.71V78.36H420.79L373.91 139.3Z"/>
      <path d="M518.38 139.3L471.5 78.36H451.58V163.8H472.81V116.65L509.08 163.8H527.68L563.95 116.65V163.8H585.18V78.36H565.26L518.38 139.3Z"/>
      <path d="M713.6 131.69V78.35H596.05V163.79H617.28V131.69H675.37L691.42 163.79H715.19L699.14 131.69H713.6ZM692.37 99.59V110.46H617.29V99.59H692.37Z"/>
      <path d="M724.47 131.69H820.79V142.57H724.47V163.8H842.02V110.46H745.7V99.59H842.02V78.36H724.47V131.69Z"/>
      <path d="M950.41 78.36L911.67 136.47L872.92 78.36H852.89V89.76L902.25 163.8H921.08L970.44 89.76V78.36H950.41Z"/>
    </svg>
  </div>
</footer>

<script>
  /* The footer is on every page, so it wires itself rather than waiting for a
     page's own entry — and it has to unwire itself too: the footer is not
     persisted across a navigation, and a clock left running would tick on a
     discarded element beside a second one on the next page. */
  let clock: ReturnType<typeof setInterval> | undefined;

  const start = () => {
    const face = document.querySelector<HTMLElement>('[data-clock]');
    if (!face) return;
    const tick = () => {
      const t = new Intl.DateTimeFormat('en-GB', {
        hour: '2-digit', minute: '2-digit', timeZone: 'America/Los_Angeles',
      }).format(new Date());
      face.textContent = `Los Angeles → ${t}`;
    };
    tick();
    clock = setInterval(tick, 30_000);
  };

  const stop = () => {
    if (clock) clearInterval(clock);
  };

  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', stop);
</script>

<style>
  /* over the hero's fixed canvases, which live inside main */
  /* A screen of its own on a desktop: the invitation at the top, the details
     at the foot, and the name filling what is left. `min-height` rather than
     `height` so a long address list grows it instead of overflowing. */
  .footer { position: relative; z-index: var(--z-ui);
            background: var(--ground); color: var(--ink);
            padding: var(--s-8) var(--page-x) 0;
            display: flex; flex-direction: column; }
  @media (min-width: 860px) { .footer { min-height: 100vh; } }

  .top { display: flex; justify-content: space-between; gap: var(--s-4);
         color: var(--ink-3); }
  .when { font-variant-numeric: tabular-nums; color: var(--ink-3); }

  /* the question, and the two ways in directly under it — they answer it, so
     they read better beneath it than sent to the far side of the page */
  .invite { margin-top: var(--s-8); }
  .ask { font-size: var(--t-h2); font-weight: var(--w-display);
         line-height: var(--lh-display); letter-spacing: var(--track-display); }

  /* the site's own button — the same slab the hero offers, with the square
     that walks to the far end of it */
  .acts { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-6); }

  /* the two sets of details, kept to the right where they always sat */
  .cols { display: grid; grid-template-columns: repeat(2, minmax(0, 14rem)); justify-content: end;
          gap: var(--s-6) var(--s-7); margin-top: auto; padding-top: var(--s-8);
          align-items: start; }
  .col { display: grid; gap: var(--s-4); align-content: start; }
  .head { color: var(--ink-3); }
  .col ul { list-style: none; display: grid; gap: 0.55rem; }
  .pairs { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0.55rem var(--s-4); }
  .col li { display: flex; gap: 0.5em; font-size: var(--t-body); color: var(--ink-2); }
  .k { color: var(--ink-3); }
  .col a { color: var(--ink-2); transition: color var(--dur-fast) ease; }
  .col a:hover { color: var(--ink); }

  /* ── the small print ──────────────────────────────────────────────── */
  /* on a rule, the policies on the left and the copyright on the right */
  .legal { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4);
           margin-top: var(--s-8); padding-top: var(--s-4);
           border-top: var(--hairline) solid var(--line); color: var(--ink-3); }
  .legal ul { list-style: none; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); }
  .legal a { color: var(--ink-3); transition: color var(--dur-fast) ease; }
  .legal a:hover { color: var(--ink); }

  /* ── the name ─────────────────────────────────────────────────────── */
  /* The last thing on the page and the largest: edge to edge between the
     page's margins, the ink sitting a margin's height off the foot. */
  .mark { margin-top: var(--s-5); padding-bottom: var(--page-x); color: var(--ink); }
  .mark svg { display: block; width: 100%; height: auto; }

  @media (max-width: 859px) {
    .footer { padding-top: var(--s-7); }
    .top { flex-direction: column; gap: var(--s-2); }
    .acts { flex-direction: column; align-items: flex-start; gap: var(--s-3); }
    .cols { grid-template-columns: 1fr; justify-content: stretch; gap: var(--s-6); padding-top: 10vh; }
    .legal { flex-direction: column; align-items: flex-start; margin-top: 10vh; }
  }
</style>
