---
/** The foot of every page: a black band, the invitation, the ways in, and
 *  the name drawn once at full width.
 *
 *  PLACEHOLDER. The shape is right, but the address, the number and the
 *  accounts are stand-ins until the client sends the real ones — everything
 *  marked below is meant to be replaced, not kept. */
import Button from '@components/ui/Button.astro';
import { site } from '@lib/site';
import { LETTERMARK, SYMBOL } from '@lib/lettermark';

const year = new Date().getFullYear();

const enquiry = [
  { label: 'hello@immrsv.studio', href: 'mailto:hello@immrsv.studio' },
  { label: '747.302.6868', href: 'tel:+17473026868' },
];
/** the page in four lines, for the reader who got to the foot of it */
const explore = [
  { label: 'Studios', href: '/#studios' },
  { label: 'Process', href: '/#process' },
  { label: 'Work', href: '/work' },
  { label: 'FAQs', href: '/#faqs' },
];
/* the last word of the invitation turns, as the headline's does: the name
   first, then what the work is meant to be, and back to the name */
const words = ['IMMRSV.', 'lasting.', 'real.', 'together.'];
/* PLACEHOLDER: the call goes to the number until the client says where a
   booking should go — a calendar link, most likely */
const acts = [
  { label: 'Discuss your project', href: 'mailto:hello@immrsv.studio' },
  { label: 'Book a call', href: 'tel:+17473026868' },
];

/* PLACEHOLDER: the practice's accounts — the two it is likeliest to have,
   pointing nowhere real until the client sends the handles */
const social = [
  { label: 'LinkedIn', href: 'https://www.linkedin.com/' },
  { label: 'Instagram', href: 'https://www.instagram.com/' },
];

/** what a site has to say about itself, at its foot */
const legal = [
  { label: 'Privacy policy', href: '/privacy' },
  { label: 'Terms of use', href: '/terms' },
];
---
<footer class="footer" id="contact" data-theme="dark">
  <!-- The symbol, large, turning on the spot at the footer's top right
       corner — its centre on the corner, so only the quarter of it that is
       in the page shows and the footer cuts off the rest. A hairline drawing behind everything, going
       round slowly enough to be noticed rather than watched. -->
  <svg class="spin" viewBox={SYMBOL.viewBox} aria-hidden="true" focusable="false">
    <g class="turn">{SYMBOL.paths.map((d) => <path d={d} />)}</g>
  </svg>
  <!-- The invitation across the top, and under it, left to right across
       the page, the details in four short columns: where the studio is,
       how to reach it, where the page's parts are, where to follow it. -->
  <div class="cols">
    <div class="invite">
      <div class="top">
      <h2 class="ask">Let’s create<br />something <span class="rot" data-footer-word data-words={JSON.stringify(words)}>{words[0]}</span></h2>
      <!-- the studio's own time, level with the invitation and at the far
           margin: where the reply would come from, what o'clock it is there
           and what day, all set by the script from the studio's zone -->
      <div class="when label" data-clock>
        <span>Los Angeles <span class="time" data-clock-time>--:--:-- --</span></span>
        <span data-clock-date>&nbsp;</span>
      </div>
      </div>
      <div class="acts">
        {acts.map((a) => <Button href={a.href} label={a.label} />)}
      </div>
    </div>

    <div class="details">
      <div class="col">
        <span class="label head">Location</span>
        <p class="based">Working globally from Los Angeles, California.</p>
      </div>
      <div class="col">
        <span class="label head">Contact</span>
        <ul>
          {enquiry.map((e) => (
            <li><a href={e.href} data-tap>{e.label}</a></li>
          ))}
        </ul>
      </div>
      <nav class="col" aria-label="Footer">
        <span class="label head">Explore</span>
        <ul>
          {explore.map((e) => (
            <li><a href={e.href} data-tap>{e.label}</a></li>
          ))}
        </ul>
      </nav>
      <div class="col">
        <span class="label head">Follow</span>
        <ul>
          {social.map((e) => (
            <li><a href={e.href} rel="noopener" target="_blank" data-tap>{e.label}</a></li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <!-- The name, the last thing on the page and as wide as the page's margins
       allow — drawn rather than set: a hairline outline whose letters are
       separate objects. Touching one shoves it along the pointer's travel,
       spins it about its centre and lights it white at once; a spring returns
       it and the light fades back off (scripts/ui/wordmarkLetters.ts). -->
  <div class="mark" data-wordmark>
    <!-- each letter is a group the cursor moves -->
    <svg viewBox={LETTERMARK.viewBox} role="img" aria-label={site.name}>
      {LETTERMARK.paths.map((d) => (
        <g data-letter>
          <path class="ltr" d={d} />
        </g>
      ))}
    </svg>
  </div>
  <!-- the small print, under the name: what the site owes its readers on
       the left, whose it is on the right -->
  <div class="legal">
    <ul>
      {legal.map((l) => <li><a class="label" href={l.href} data-tap>{l.label}</a></li>)}
    </ul>
    <span class="label">© {year} {site.name}. All rights reserved.</span>
  </div>

</footer>

<script>
  import { createWordmarkLetters } from '../../scripts/ui/wordmarkLetters';
  import { createRotatingWord } from '../../scripts/ui/rotatingWord';

  /* The footer is on every page, so it wires itself rather than waiting for a
     page's own entry — and it has to unwire itself too: the footer is not
     persisted across a navigation, and a clock left running would tick on a
     discarded element beside a second one on the next page. */
  let clock: ReturnType<typeof setInterval> | undefined;
  let letters: { destroy(): void } | null = null;
  let word: { destroy(): void } | null = null;
  let seen: IntersectionObserver | null = null;

  const start = () => {
    // the letters answer the cursor: nothing to shove without one
    const mark = document.querySelector<HTMLElement>('[data-wordmark]');
    if (mark && matchMedia('(hover: hover) and (pointer: fine)').matches
        && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
      letters = createWordmarkLetters(mark);
    }

    // the invitation's last word turns as the headline's does — but only
    // once the footer is on screen, so it is the name when you arrive
    const rot = document.querySelector<HTMLElement>('[data-footer-word]');
    if (rot) {
      seen = new IntersectionObserver(([e]) => {
        if (!e.isIntersecting || word) return;
        word = createRotatingWord(rot, { firstDelay: 1600, hold: 2200 });
        seen?.disconnect();
      }, { threshold: 0.4 });
      seen.observe(rot);
    }

    const time = document.querySelector<HTMLElement>('[data-clock-time]');
    const date = document.querySelector<HTMLElement>('[data-clock-date]');
    if (!time || !date) return;
    const zone = 'America/Los_Angeles';
    const fTime = new Intl.DateTimeFormat('en-US', { hour: '2-digit', minute: '2-digit', second: '2-digit', hour12: true, timeZone: zone });
    const fDate = new Intl.DateTimeFormat('en-US', { weekday: 'long', month: 'short', day: 'numeric', year: 'numeric', timeZone: zone });
    const fZone = new Intl.DateTimeFormat('en-US', { timeZoneName: 'shortOffset', timeZone: zone });
    let day = '';
    const tick = () => {
      const now = new Date();
      time.textContent = fTime.format(now);
      // the day and the offset only when they change — and the offset
      // written as "GMT -07", the way a timetable prints it
      const d = fDate.format(now);
      if (d !== day) {
        day = d;
        const gmt = fZone.formatToParts(now).find((p) => p.type === 'timeZoneName')?.value ?? 'GMT';
        const m = /GMT([+-])(\d+)(?::(\d+))?/.exec(gmt);
        const off = m ? `GMT ${m[1]}${m[2].padStart(2, '0')}${m[3] ? ':' + m[3] : ''}` : gmt;
        date.textContent = `${d} (${off})`;
      }
    };
    tick();
    // on the second: the studio's own time, running
    clock = setInterval(tick, 1000);
  };

  const stop = () => {
    if (clock) clearInterval(clock);
    letters?.destroy();
    letters = null;
    seen?.disconnect(); seen = null;
    word?.destroy(); word = null;
  };

  document.addEventListener('astro:page-load', start);
  document.addEventListener('astro:before-swap', stop);
</script>

<style>
  /* over the hero's fixed canvases, which live inside main */
  /* A screen of its own on a desktop: the invitation at the top, the details
     at the foot, and the name filling what is left. `min-height` rather than
     `height` so a long address list grows it instead of overflowing. */
  .footer { position: relative; z-index: var(--z-ui);
            background: var(--ground); color: var(--ink);
            /* well down from the section above: the invitation is a line
               to arrive at, not a caption to what came before */
            padding: max(var(--s-8), 14vh) var(--page-x) 0;
            display: flex; flex-direction: column;
            /* the turning symbol runs off the edge: the footer cuts it there */
            overflow: clip; }
  @media (min-width: 860px) { .footer { min-height: 100vh; } }

  /* ── the turning symbol ───────────────────────────────────────────── */
  /* Sized to the screen and centred on the top right corner, so most of it
     is off the page. Its own box is let go of, or the corners of the cube
     would be cut off by it as it turns. It is a drawing behind the
     words, never something they have to make room for: no box in the flow,
     no clicks, a hairline as the dial behind the work is. */
  .spin { position: absolute; z-index: 0; right: 0; top: 0;
          height: min(92vw, 135vh); width: auto; max-width: none; overflow: visible;
          translate: 50% -50%;
          pointer-events: none;
          fill: none; stroke: var(--ink-dim); stroke-width: 1; }
  .spin path { vector-effect: non-scaling-stroke; }
  /* one turn a minute, about its own middle */
  .turn { transform-box: fill-box; transform-origin: center;
          animation: turn 60s linear infinite; }
  @keyframes turn { to { transform: rotate(360deg); } }
  @media (prefers-reduced-motion: reduce) { .turn { animation: none; } }
  /* everything else is in front of it */
  .footer > :not(.spin) { position: relative; z-index: 1; }

  /* the time holds its width as the seconds turn */
  .when { font-variant-numeric: tabular-nums; }
  @media (max-width: 719px) {
    .top { flex-direction: column; gap: var(--s-5); }
    .when { order: -1; padding-top: 0; justify-items: start; text-align: left; }
  }

  /* the question, and the two ways in directly under it — they answer it, so
     they read better beneath it than sent to the far side of the page */
  .invite { margin: 0; }
  /* the question at the left, the time at the right, level with its top */
  .top { display: flex; justify-content: space-between; align-items: flex-start; gap: var(--s-6); }
  /* the studio's clock: two lines of the page's small capitals, flush
     right — the city and the time, and the day under them */
  .when { flex: none; display: grid; gap: var(--s-2); justify-items: end; text-align: right;
          color: var(--ink-3); padding-top: 0.3em; }
  .when .time { margin-left: 0.5em; }
  .ask { font-size: var(--t-h2); font-weight: var(--w-display);
         line-height: var(--lh-display); letter-spacing: var(--track-display); }
  /* the turning word, letter by letter, as the headline's */
  .rot { display: inline-block; white-space: nowrap; }
  .rot :global(i) { display: inline-block; font-style: normal; transition: opacity 0.75s ease-in-out, filter 0.75s ease-in-out; }
  .rot :global(i.out) { opacity: 0; filter: blur(9px); }
  @media (prefers-reduced-motion: reduce) { .rot :global(i) { transition: none; } }

  /* the site's own button — the same slab the hero offers, with the square
     that walks to the far end of it */
  /* the two ways in, the site's buttons at their own size, as the hero
     sets its pair */
  .acts { display: flex; flex-wrap: wrap; gap: var(--s-2); margin-top: var(--s-6); }

  /* the invitation, and the details a step under it */
  /* the invitation stands at the top; the details go down to the name,
     as its caption, with the screen's spare height between the two */
  .cols { flex: 1; display: flex; flex-direction: column; justify-content: space-between;
          gap: var(--s-8); }
  /* the four columns of details, quarters of the page from the left */
  .details { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); column-gap: var(--s-6); row-gap: var(--s-7);
             align-content: start; }
  .col { display: grid; gap: var(--s-4); align-content: start; }
  .head { color: var(--ink-3); line-height: 1; }
  .col ul { list-style: none; display: grid; gap: 0.55rem; }
  .col li { display: flex; gap: 0.5em; font-size: var(--t-body); color: var(--ink-2); }
  .based { font-size: var(--t-body); line-height: var(--lh-body); color: var(--ink-2); max-width: 22ch; }
  .col a { color: var(--ink-2); transition: color var(--dur-fast) ease; }
  .col a:hover { color: var(--ink); }

  /* ── the small print ──────────────────────────────────────────────── */
  /* under the name, the policies on the left and the copyright on the right */
  .legal { display: flex; justify-content: space-between; align-items: center; gap: var(--s-4);
           margin-top: var(--s-4); padding-bottom: var(--s-4); color: var(--ink-3); }
  .legal ul { list-style: none; display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-5); }
  .legal a { color: var(--ink-3); transition: color var(--dur-fast) ease; }
  .legal a:hover { color: var(--ink); }

  /* ── the name ─────────────────────────────────────────────────────── */
  /* The last thing on the page and the largest: edge to edge between the
     page's margins, standing at the foot of the screen whatever is above it.
     The letters may be shoved past the mark's box, so it is not clipped. */
  .mark { padding-top: var(--s-7); color: var(--ink); }
  .mark svg { display: block; width: 100%; height: auto; overflow: visible; }
  /* the letter is the group: it is what the cursor moves, about its middle */
  [data-letter] { transform-box: fill-box; transform-origin: 50% 50%; }
  /* outline at rest, a true hairline at any scale, in the same dim line as
     the symbol turning at the corner; the interior is the target */
  .ltr { fill: currentColor; fill-opacity: 0;
         stroke: var(--ink-dim); stroke-width: 1px; vector-effect: non-scaling-stroke;
         pointer-events: fill;
         transition: fill-opacity 0.95s ease, fill 0.95s ease, stroke 0.95s ease; }
  /* contact is instant — no ramp, the letter is simply white; letting go
     fades it back to the page's ink and then to an outline */
  .lit .ltr { fill: #fff; stroke: #fff; fill-opacity: 1; transition: none; }
  /* nothing to shove without a pointer, so the name simply stands solid */
  @media (hover: none), (prefers-reduced-motion: reduce) {
    .ltr { fill-opacity: 1; stroke: currentColor; transition: none; }
  }

  /* side by side only where the question keeps to its two lines: narrower,
     the list goes under the details instead of breaking the line in three */

  @media (max-width: 859px) {
    .footer { padding-top: max(var(--s-8), 10vh); }
    .acts { flex-direction: column; align-items: flex-start; gap: var(--s-3); }
    .cols { gap: 10vh; }
    .mark { padding-top: var(--s-7); }
    .legal { flex-direction: column; align-items: flex-start; }
  }
  /* two abreast where four would squeeze an address; one under the other
     on a phone, which has no width for two */
  @media (max-width: 859px) {
    .details { grid-template-columns: 1fr 1fr; }
  }
  @media (max-width: 479px) {
    .details { grid-template-columns: 1fr; }
  }
</style>
