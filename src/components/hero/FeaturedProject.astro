---
import type { Project } from '@lib/sanity/types';
interface Props { project: Project; class?: string; }
const { project, class: cls } = Astro.props;
---
<a class:list={['feat', 'arrives', cls]} href={`/work/${project.slug}`} data-tap style="--arrive-delay: .7s">
  <div class="media">
    <div class="top">
      <span class="label lbl">Featured project</span>
      {project.year && <span class="label meta">{project.year}</span>}
    </div>
    {project.cover && <img src={project.cover.url} alt={project.cover.alt ?? project.title} loading="eager" decoding="async" />}
  </div>
  <div class="ttl">
    <span>{project.title}{project.summary && <small>{project.summary}</small>}</span>
  </div>
</a>

<style>
  /* Filled, not drawn. It used to be a hairline frame with the site's square
     on each corner, which worked while everything was square and stopped
     working the moment the picture inside it took a radius: a drawn corner
     and a rounded one in the same 10px cannot both be right. So the frame and
     its four squares are gone and the card is simply a plane — the same 5%
     the glass is tinted with, on the same corner as the picture it holds.
     The placement is the parent's: it can set --feat-w to fill its own
     column.
     The inset is the card's padding and not a margin on the picture: with no
     border left to stop it, a top margin on the first child collapses
     straight through the card and the picture sits on its edge. */
  .feat { position: relative; display: block; width: var(--feat-w, min(23.75rem, 30vw));
          color: var(--ink); background: var(--glass);
          border-radius: var(--radius-media); padding: 0.625rem;
          transition: background var(--dur-fast) ease; }
  .feat:hover { background: var(--glass-hover); }
  .media { position: relative; overflow: hidden;
           border-radius: var(--radius-media); }
  .media::after { content: ""; position: absolute; inset: 0; pointer-events: none;
    background: linear-gradient(180deg, rgb(var(--ground-rgb) / 0.62) 0%, rgb(var(--ground-rgb) / 0.25) 38%, rgb(var(--ground-rgb) / 0) 65%); }
  .top { position: absolute; left: 0; right: 0; top: 0; z-index: 1; display: flex; justify-content: space-between; align-items: baseline; padding: 0.625rem 0.75rem 0.5rem; }
  .lbl { color: var(--ink); }
  .meta { color: var(--ink-3); }
  img { width: 100%; aspect-ratio: 2 / 1; object-fit: cover; opacity: 0.9; transition: opacity 0.4s ease, transform 1.2s ease; }
  .feat:hover img { opacity: 1; transform: scale(1.03); }
  /* the card's own padding gives it ten of the twelve it sits in */
  .ttl { padding: 0.75rem 0.125rem 0.125rem; font-size: var(--t-small); line-height: 1.3; }
  .ttl small { display: block; margin-top: 3px; font-size: var(--t-caption);
                letter-spacing: var(--track-caps); color: var(--ink-3); }
</style>
