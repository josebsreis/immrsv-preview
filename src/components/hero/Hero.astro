---
/** The hero: the particle mark (a client island booted by src/scripts/home.ts)
 *  behind an edge-anchored layer of DOM — statement, CTAs, and a bottom row
 *  holding the cue, the sentence and the featured project. Copy comes in as props. */
import Button from '@components/ui/Button.astro';
import ScrollCue from '@components/ui/ScrollCue.astro';
import FeaturedProject from '@components/hero/FeaturedProject.astro';
import type { HomeContent } from '@lib/sanity/types';

interface Props { content: HomeContent['hero']; featured?: HomeContent['featuredProject']; }
const { content, featured } = Astro.props;
const [line1, line2 = ''] = content.headline.split('\n');
---
<div class="canvas-host" data-hero-canvas></div>
<div class="veil" data-veil aria-hidden="true"></div>

<section class="hero" aria-label="Introduction">
  <!-- The headline is there from the first frame: it is the largest thing on
       the screen, and a headline that fades in is one that a first-paint
       measure never sees. The rest of the hero arrives after it. -->
  <div class="lead">
    <h1>{line1}<br />{line2} <span class="rot" data-rotating-word data-words={JSON.stringify(content.words)}>{content.words[0]}</span></h1>
    <div class="cta arrives" style="--arrive-delay: .6s">
      <Button href={content.primaryCta.href} label={content.primaryCta.label} />
      <Button href={content.secondaryCta.href} label={content.secondaryCta.label} />
    </div>
  </div>

  <!-- placement belongs to the hero, so children are wrapped rather than styled across scopes -->
  <div class="bottom">
    <div class="cue-slot"><ScrollCue /></div>
    <div class="desc-slot"><p class="desc arrives" style="--arrive-delay: .7s">{content.description}</p></div>
    {featured && <div class="feat-slot"><FeaturedProject project={featured} /></div>}
  </div>
</section>

<style>
  /* The canvas is pinned to the largest the viewport ever gets, not to what
     it is this instant: on a phone the address bar slides in and out as you
     scroll, and a canvas that tracked it would resize — and so re-lay-out the
     mark — on every one of those. */
  .canvas-host { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; height: 100lvh; z-index: var(--z-canvas); pointer-events: none; }
  .canvas-host :global(canvas) { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; height: 100lvh; display: block; }
  .veil { position: fixed; inset: 0; z-index: var(--z-veil); background: var(--ground); opacity: 0; pointer-events: none; }

  .hero { position: relative; min-height: 100vh; min-height: 100svh; pointer-events: none; }
  .hero :global(a) { pointer-events: auto; }

  .lead { position: absolute; left: var(--page-x); top: clamp(7.375rem, 16vh, 10.625rem); z-index: var(--z-ui); }
  h1 { font-size: var(--t-display); font-weight: var(--w-display);
       line-height: var(--lh-display); letter-spacing: var(--track-display); max-width: 11em; }
  .rot { display: inline-block; white-space: nowrap; }
  .rot :global(i) { display: inline-block; font-style: normal; transition: opacity 0.75s ease-in-out, filter 0.75s ease-in-out; }
  .rot :global(i.out) { opacity: 0; filter: blur(9px); }
  .cta { display: flex; gap: var(--s-2); margin-top: 2.375rem; }

  /* the anchored bottom row: cue at the left edge, the sentence centred in
     whatever is left between it and the card, the card at the right edge */
  .bottom { position: absolute; left: var(--page-x); right: var(--page-x); bottom: var(--page-y); z-index: var(--z-ui);
            display: flex; align-items: flex-end; gap: var(--s-6); }
  .cue-slot { flex: none; }
  .desc-slot { flex: 1 1 auto; min-width: 0; display: flex; justify-content: center; }
  .desc { max-width: 20.625rem; font-size: var(--t-lead); line-height: var(--lh-lead);
          letter-spacing: var(--track-lead); color: var(--ink); }
  .feat-slot { flex: none; }

  /* too narrow for three across: the card stands down and the row keeps its
     two corners — the cue at the left, the sentence at the right */
  @media (max-width: 1099px) {
    .feat-slot { display: none; }
  }
  @media (min-width: 720px) and (max-width: 1099px) {
    .desc-slot { justify-content: flex-end; }
    .desc { max-width: 24rem; font-size: var(--t-body); }
  }

  /* the card takes too much of a phone screen — the sentence carries it, with
     the cue reduced to its squares beside it */
  @media (max-width: 719px) {
    .lead { left: var(--page-x); top: 6.5rem; }
    .cta { flex-direction: column; align-items: flex-start; }
    .bottom { left: var(--page-x); right: var(--page-x); bottom: var(--s-5); gap: var(--s-4); }
    .desc-slot { justify-content: flex-start; }
    .desc { max-width: none; font-size: var(--t-body); }
  }
</style>
