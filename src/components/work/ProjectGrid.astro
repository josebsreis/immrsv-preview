---
import ProjectCard from './ProjectCard.astro';
import type { Project } from '@lib/sanity/types';
interface Props { projects: Project[]; }
const { projects } = Astro.props;
---
<div class="grid">
  {projects.map((p, i) => <ProjectCard project={p} eager={i < 2} />)}
</div>

<style>
  .grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: var(--s-7) var(--s-6); }
  @media (max-width: 719px) { .grid { grid-template-columns: 1fr; gap: var(--s-6); } }
</style>
