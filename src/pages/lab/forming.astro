---
/** A lab page, not part of the site: the handover from the dark half of the
 *  homepage to the light one, as a figure forming. A dark screen stands in
 *  for the hero above it and a light one for the studios below.
 *
 *  Two layouts, chosen from the URL: `?layout=center` stands her in the
 *  middle with a line either side; the default stands her at the right and
 *  runs the lines past her on the left. */
import Base from '@layouts/Base.astro';

const title = 'Everything we make is built.';
const beats = [
  { word: 'Draw', line: 'The building, at real scale, from the first sketch.' },
  { word: 'Model', line: 'Every surface built, not painted on.' },
  { word: 'Light', line: 'Real optics, real materials, no flattery.' },
  { word: 'Build', line: 'Shipped, and kept working.' },
];
---
<Base theme="dark" title="Lab — forming">
  <main class="lab" data-forming>
    <section class="before">
      <p class="label">hero stands here — scroll</p>
    </section>

    <div class="track" data-track>
      <div class="pane" data-pane>
        <!-- the light ground: a rectangle that starts as the mark and grows -->
        <div class="window" data-window></div>
        <!-- the slot: a rectangle that starts as the mark and grows -->
        <div class="slot" data-box>
          <canvas></canvas>
        </div>
        <p class="title" data-title>{title}</p>
        {beats.map((b, i) => (
          <div class={`beat ${i % 2 ? 'right' : 'left'}`} data-beat>
            <span class="label n">{String(i + 1).padStart(2, '0')}</span>
            <span class="word">{b.word}</span>
            <span class="line">{b.line}</span>
          </div>
        ))}
      </div>
    </div>

    <section class="after">
      <p class="label">studios follow here</p>
    </section>

    <p class="note label"><span data-p>0.00</span></p>
  </main>

  <script>
    import { startForming } from '../../scripts/lab/forming';
    const root = document.querySelector<HTMLElement>('[data-forming]')!;
    const out = document.querySelector<HTMLElement>('[data-p]')!;
    const q = new URLSearchParams(location.search);
    if (q.get('layout') === 'center') root.querySelector<HTMLElement>('[data-pane]')!.classList.add('center');
    const lab = startForming(root, (p) => { out.textContent = p.toFixed(2); });
    (window as any).forming = lab;
    // `?p=0.5` holds the pane at that point of the track, for a still of it
    const want = Number(q.get('p'));
    if (q.has('p') && want >= 0 && want <= 1) {
      root.querySelector<HTMLElement>('.before')!.style.display = 'none';
      lab.set(want);
    }
  </script>
</Base>

<style>
  .lab { position: relative; }
  .before, .after { height: 100vh; display: grid; place-items: center; }
  .before { background: #060606; color: #727276; }
  .after { background: #f5f5f7; color: #6e6e73; }

  /* as tall as the scroll it wants; the pane inside holds still */
  .track { height: 420vh; position: relative; }
  .pane { position: sticky; top: 0; height: 100vh; overflow: hidden; background: #060606;
          /* the slot's height, and where its middle sits — the rest is placed off these */
          --slot-h: min(70vh, 150vw); --slot-x: calc(100% - var(--page-x) - var(--slot-h) / 3); }
  .pane.center { --slot-x: 50%; }

  .window { position: absolute; inset: 0; background: #f5f5f7; }
  /* the figure stands in a portrait slot, the way a character stands on a
     select screen. Its ground is the video's own, for the frame before the
     first image has arrived */
  .slot { position: absolute; left: var(--slot-x); top: 50%; translate: -50% -50%;
          height: var(--slot-h); aspect-ratio: 2 / 3;
          background: #ebeaec; overflow: hidden;
          clip-path: inset(50%); }
  /* the video's ground is a shade under the site's light one; lifted here so
     the two are one plane once the ground has spread */
  .slot canvas { display: block; filter: brightness(1.045); }

  /* the line that names the section, on the light */
  .title { position: absolute; margin: 0; white-space: nowrap; color: #1d1d1f;
           font-size: var(--t-lead); font-weight: 500; letter-spacing: -0.01em;
           opacity: var(--v, 0); transform: translateY(calc((1 - var(--v, 0)) * 10px)); --v: 0; }
  /* under the slot when she is in the middle; beside her, where the lines
     will follow, when she is at the side */
  .center .title { left: 50%; top: calc(50% + var(--slot-h) / 2 + 1.6rem); translate: -50% 0; }
  .pane:not(.center) .title { left: var(--page-x); top: 50%; translate: 0 -50%; }

  /* the four lines. Each carries how present it is (--v) and where it is in
     its life (--t, 0 to 1): at the side they pass by, rising through the
     place the title stood; in the middle they only arrive and leave */
  .beat { position: absolute; top: 50%; max-width: 18rem;
          display: flex; flex-direction: column; gap: 0.6rem; color: #1d1d1f;
          opacity: var(--v, 0); pointer-events: none; --v: 0; --t: 0; }
  .n { color: #9c9ca0; }
  .word { font-size: var(--t-display); font-weight: 500; letter-spacing: -0.03em; line-height: 0.95; }
  .line { font-size: var(--t-small); color: #6e6e73; max-width: 16rem; line-height: 1.5; }

  .pane:not(.center) .beat { left: var(--page-x);
                             transform: translateY(calc(-50% + (0.5 - var(--t)) * 6rem)); }
  .center .beat { transform: translateY(calc(-50% + (1 - var(--v)) * 14px)); }
  .center .beat.left { left: var(--page-x); }
  .center .beat.right { right: var(--page-x); text-align: right; align-items: flex-end; }

  @media (max-width: 719px) {
    .pane { --slot-h: 84vw; --slot-x: 50%; }
    .slot { top: 40%; }
    .title { left: 50% !important; top: calc(40% + var(--slot-h) / 2 + 1.2rem) !important;
             translate: -50% 0 !important; font-size: var(--t-small); }
    .beat { top: auto; bottom: calc(var(--page-y) + 2.5rem); left: var(--page-x) !important;
            right: auto !important; text-align: left !important; align-items: flex-start !important;
            max-width: 80vw; transform: translateY(calc((1 - var(--v)) * 10px)) !important; }
    .word { font-size: 2rem; }
  }

  .note { position: fixed; right: var(--page-x); bottom: var(--page-y); color: #9c9ca0;
          mix-blend-mode: difference; pointer-events: none; z-index: 10; }
</style>
