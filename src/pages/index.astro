---
import Base from '@layouts/Base.astro';
import Loader from '@components/transitions/Loader.astro';
import ShutterScroll from '@components/transitions/ShutterScroll.astro';
import Hero from '@components/hero/Hero.astro';
import WordmarkPanel from '@components/home/WordmarkPanel.astro';
import Manifesto from '@components/home/Manifesto.astro';
import Studios from '@components/home/Studios.astro';
import Brands from '@components/home/Brands.astro';
import ProjectGrid from '@components/work/ProjectGrid.astro';
import { getHome, getProjects } from '@lib/sanity/queries';

const [home, projects] = await Promise.all([getHome(), getProjects()]);
---
<Base theme="dark">
  <Loader />
  <main class="main">
    <div class="dark">
      <Hero content={home.hero} featured={home.featuredProject} />
      <WordmarkPanel />
      <Manifesto content={home.about} />
      <Brands content={home.brands} />
      <ShutterScroll rows={10} />
    </div>

    <section class="next" id="work" data-next data-theme="light">
      <Studios content={home.studios} />
      <header class="head">
        <span class="label">Selected work</span>
        <a class="label all" href="/work" data-tap>All projects →</a>
      </header>
      <ProjectGrid projects={projects.slice(0, 4)} />
    </section>
  </main>
  <script src="../scripts/home.ts"></script>
</Base>

<style>
  .main { position: relative; z-index: var(--z-main); }
  /* the dark half scrolls over the fixed hero canvases; the shutter's rows
     close at its end and the light half simply continues from there */
  .dark { position: relative; }
  /* above the hero's fixed layers — its own ground closes the dark half off */
  .next { position: relative; z-index: var(--z-ui); background: var(--ground); color: var(--ink);
          padding: 2vh var(--page-x) 12vh; }
  .head { display: flex; justify-content: space-between; align-items: baseline;
          padding-top: var(--s-6); margin-bottom: var(--s-7); color: var(--ink-3);
          border-top: var(--hairline) solid var(--line); }
  .all { color: var(--ink); }
</style>
