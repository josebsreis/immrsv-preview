---
import Base from '@layouts/Base.astro';
import Forming from '@components/home/Forming.astro';
import Hero from '@components/hero/Hero.astro';
import Marquee from '@components/home/Marquee.astro';
import Manifesto from '@components/home/Manifesto.astro';
import Studios from '@components/home/Studios.astro';
import Testimonials from '@components/home/Testimonials.astro';
import Faqs from '@components/home/Faqs.astro';
import WorkPile from '@components/home/WorkPile.astro';
import Brands from '@components/home/Brands.astro';
import { getHome, getProjects, getSettings } from '@lib/sanity/queries';
import { site } from '@lib/site';

const home = await getHome();
const projects = await getProjects();
const settings = await getSettings();

/* who the site belongs to, for search engines: the name, how to reach it,
   where it is, and the accounts that are really its own (a link to a
   network's front page is a placeholder, not an account) */
const url = Astro.site!.href;
const accounts = settings.social.map((s) => s.url).filter((u) => { try { return new URL(u).pathname.length > 1; } catch { return false; } });
const jsonLd = [
  {
    '@context': 'https://schema.org', '@type': 'Organization',
    name: site.name, url, logo: new URL('/icon-512.png', url).href,
    email: settings.email, telephone: settings.phone,
    address: { '@type': 'PostalAddress', addressLocality: 'Los Angeles', addressRegion: 'CA', addressCountry: 'US' },
    ...(accounts.length ? { sameAs: accounts } : {}),
  },
  { '@context': 'https://schema.org', '@type': 'WebSite', name: site.name, url },
];
---
<Base theme="dark" seo={home.seo} jsonLd={jsonLd}>
  <main class="main" data-page="home">
    <div class="dark" data-hold>
      <Hero content={home.hero} />
      <Marquee items={home.studios.items.map((s) => s.name)} />
      <Manifesto content={home.about} />
      {/* the firms the practice has worked for, right after it has said what
          it is: the marks are the receipt for the statement. The dark half
          ends here; 'Your team, extended.' opens out of it, on the light */}
      <div class="clients"><Brands content={home.brands} /></div>
      <div class="scrim" data-scrim aria-hidden="true"></div>
    </div>

    <!-- the light half travels over the dark one, the figure being built at
         its head: the ground opens from the mark, and the section arrives
         inside that opening; the first studio follows -->
    <div class="light" data-light>
      <Forming {...home.team} />
      <section class="next" id="work" data-next data-theme="light">
        <Studios content={home.studios} projects={projects} />
        {/* The process section is off the page: the handover above says the
            same thing, in a picture, and saying it twice made the second one
            read as filler. Component and content are both still here — put
            <Process content={home.process} /> back to restore it. */}
        <Testimonials content={home.testimonials} />
        {/* the work the studio reels have not shown, on a dark ground between
            the client stories and the questions, so the page's second half
            is not two blocks of text in a row */}
        <WorkPile content={home.work} projects={projects} />
        <Faqs content={home.faqs} person={home.about.founder} />
      </section>
    </div>
  </main>
  <script src="../scripts/home.ts"></script>
</Base>

<style>
  .main { position: relative; z-index: var(--z-main); }
  /* the dark half holds once its end meets the bottom of the screen (the top
     offset is set in JS: viewport − height), and the next section rides up
     over it — its edge drawn as a rule, so a dark sheet over a dark one is
     seen arriving rather than swallowing the logos */
  .dark { position: sticky; top: 0; z-index: 1; }
  /* the dark half is put out as the light one climbs over it */
  /* inside the held half's own stacking context, so it is a local number and
     not a page layer — it only has to sit over the panels in there, which
     ride at --z-ui */
  .scrim { position: fixed; inset: 0; z-index: calc(var(--z-ui) + 1);
           background: var(--ground); opacity: 0; pointer-events: none; }
  /* Covered edge to edge by the light half (scripts/ui/scrollChoreography),
     the held half's full-screen layers — the figure's canvas, its veil and
     this scrim — are let go: unseen, they were still blended into every
     frame that changed. Only these: the words in it stay where a screen
     reader can find them. */
  .dark[data-covered] .scrim,
  .dark[data-covered] :global([data-veil]),
  .dark[data-covered] :global([data-hero-canvas]) { visibility: hidden; }
  .light { position: relative; z-index: var(--z-ui); }
  /* the clients' lattice holds the page margins itself here, on the dark
     ground, a section's air above it */
  .clients { position: relative; z-index: var(--z-ui); padding: var(--section-y) var(--page-x) 0; }
  /* no air at its head: the first studio's panel is the head of the light
     half, and it is the whole of the seam */
  /* The studios' sheet rides up over the figure's last screen: pulled up a
     screen, over it, and see-through down to the foot of its tab (--lip,
     measured by the forming script) so she is covered by the tab and the
     first panel, not by a wall of ground coming up the screen. */
  .next { position: relative; z-index: 1; background: var(--ground); color: var(--ink); padding: 0 var(--page-x); }
  /* only while the figure's section is live: without it there is no held
     last screen to ride over */
  .light:has([data-forming][data-live]) .next {
    margin-top: -100vh; margin-top: -100svh;
    background: linear-gradient(var(--ground), var(--ground)) 0 var(--lip, 0px) / 100% 100% no-repeat; }
  /* and the tab meets her straight away, with no air above it */
  .light:has([data-forming][data-live]) .next :global(.studios .head) { padding-top: 0; }
</style>
