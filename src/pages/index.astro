---
import Base from '@layouts/Base.astro';
import Forming from '@components/home/Forming.astro';
import Hero from '@components/hero/Hero.astro';
import Marquee from '@components/home/Marquee.astro';
import Manifesto from '@components/home/Manifesto.astro';
import Studios from '@components/home/Studios.astro';
import Testimonials from '@components/home/Testimonials.astro';
import Faqs from '@components/home/Faqs.astro';
import WorkPile from '@components/home/WorkPile.astro';
import Brands from '@components/home/Brands.astro';
import { getHome, getProjects } from '@lib/sanity/queries';

const home = await getHome();
const projects = await getProjects();
---
<Base theme="dark">
  <main class="main" data-page="home">
    <div class="dark" data-hold>
      <Hero content={home.hero} featured={home.featuredProject} />
      <Marquee items={home.studios.items.map((s) => s.name)} />
      <Manifesto content={home.about} />
      <Brands content={home.brands} />
      <div class="scrim" data-scrim aria-hidden="true"></div>
    </div>

    <!-- the light half travels over the dark one, the figure being built at
         its head: the ground opens from the mark, and the section arrives
         inside that opening -->
    <div class="light" data-light>
      <Forming />
      <section class="next" id="work" data-next data-theme="light">
        <Studios content={home.studios} />
        {/* The process section is off the page: the handover above says the
            same thing, in a picture, and saying it twice made the second one
            read as filler. Component and content are both still here — put
            <Process content={home.process} /> back to restore it. */}
        <Testimonials content={home.testimonials} />
        {/* the work the studio reels have not shown, on a dark ground between
            the client stories and the questions, so the page's second half
            is not two blocks of text in a row */}
        <WorkPile content={home.work} projects={projects} />
        <Faqs content={home.faqs} person={home.about.founder} />
      </section>
    </div>
  </main>
  <script src="../scripts/home.ts"></script>
</Base>

<style>
  .main { position: relative; z-index: var(--z-main); }
  /* the dark half holds once its end meets the bottom of the screen (the top
     offset is set in JS: viewport − height), and the light half rides up over
     it — the figure being built at its head */
  .dark { position: sticky; top: 0; z-index: 1; }
  /* the dark half is put out as the light one climbs over it */
  /* inside the held half's own stacking context, so it is a local number and
     not a page layer — it only has to sit over the panels in there, which
     ride at --z-ui */
  .scrim { position: fixed; inset: 0; z-index: calc(var(--z-ui) + 1);
           background: var(--ground); opacity: 0; pointer-events: none; }
  .light { position: relative; z-index: var(--z-ui); }
  /* no air at its head: the section above ends on a thread down the middle of
     the page and the studios pick it up at their first pixel — two vh here is
     a visible break in a line that is meant to be one */
  .next { background: var(--ground); color: var(--ink); padding: 0 var(--page-x) 12vh; }
</style>
